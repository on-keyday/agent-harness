config.go.package = "protocol"

enum RunnerMessageType:
    :u8
    hello
    task_accepted
    task_started
    task_finished
    heartbeat
    establish_relay_response
    request_chained_relay
    remote_forward_conn
    remote_forward_bind_result
    exec_run_finished  # an out-of-band exec ended; carries its exit code

enum RunnerRequestType:
    :u8
    assign_task
    cancel_task
    open_exec
    runner_hello_response
    task_wake
    open_file_transfer
    list_files
    establish_relay
    chained_relay_response
    open_port_forward
    close_port_forward
    git_query          # read-only git query against a task's worktree
    open_exec_run      # run one argv in a task's worktree, out of band
    close_exec_run     # cancel a running exec by id. Needed as its own
                       # request because closing the exec's stream does NOT
                       # stop the child: the frame pump reads EOF and ends
                       # its input goroutine while the process runs on.

# AllowedRoot is a single repository root path the runner is willing to accept tasks for.
format AllowedRoot:
    path_len :u16
    path :[path_len]u8

# ClaudeArg is one CLI argument forwarded verbatim to the spawned claude process.
# Per-arg length is u16 so individual flags / values can be up to 64KiB; in
# practice they are short (`--resume <uuid>`, `--add-dir <path>`).
format ClaudeArg:
    arg_len :u16
    arg :[arg_len]u8

# ClaudeArgs is a length-prefixed list of per-task extra CLI arguments.
# Inserted by clients (cli / tui / webui) at submit / open-interactive time;
# carried through SubmitRequest / OpenInteractiveRequest to AssignTask /
# OpenExecRunnerRequest so the runner can append them to the runner-global
# --claude-args baseline before exec'ing claude.
format ClaudeArgs:
    args_len :u16
    args :[args_len]ClaudeArg

# AgentProfileName is one named agent-profile a runner advertises (e.g.
# "claude" / "codex" / a custom launch profile). Carried in RunnerHello /
# RunnerInfo so clients can offer a per-session profile picker.
format AgentProfileName:
    name_len :u8
    name :[name_len]u8

# RunnerHello replaces the old single-repo shape.
# hostname is the runner's short hostname (for display / pinning).
# max_tasks is the concurrency limit this runner enforces (>=1; 0 -> server rejects).
# allowed_roots lists every repo root the runner can serve.
format RunnerHello:
    version :u8
    hostname_len :u8
    hostname :[hostname_len]u8
    # goos is runtime.GOOS on the runner's host — "linux", "windows", "darwin".
    #
    # A STRING rather than an enum: GOOS is an open set, and a runner on a
    # platform this schema has not heard of should report it rather than be
    # forced into "other". Empty means a runner that predates this field.
    #
    # It exists because the harness had no idea what OS a runner ran on, and
    # things that MUST know were guessing. The ssh gateway hard-coded `sh -c`
    # for every `ssh host cmd`, which happened to work on one Windows box
    # because Git for Windows had put sh on PATH.
    goos_len :u8
    goos :[goos_len]u8
    max_tasks :u16
    allowed_roots_len :u8
    allowed_roots :[allowed_roots_len]AllowedRoot
    # basename of the agent binary the runner runs (--claude-bin): "claude" /
    # "gemini" / "codex" / "bash" / ... . Empty = unknown.
    agent_bin_len :u8
    agent_bin :[agent_bin_len]u8
    # whether the runner injects .claude/{settings.json,skills} for its tasks
    # (= the inbox hook AND this skill are present). False = peer follows none
    # of the skill conventions even if it is an agent CLI.
    skills_injected :u1
    reserved :u7
    # named agent profiles this runner can launch a session under (empty =
    # runner has no profile concept beyond its single --claude-bin).
    agent_profiles_len :u8
    agent_profiles :[agent_profiles_len]AgentProfileName

# AuthRole discriminates which identity type is carried in a PskAuthRequest.
enum AuthRole:
    :u8
    client = 0  # ClientHello identity (operator cli/tui/webui or in-task agent)
    runner = 1  # RunnerHello identity (runner registration)

# PskAuthStatus is the outcome of the PSK + identity gate.
# Replaces the hand-written constant in appwire/psk.go (Task 6 migrates refs).
enum PskAuthStatus:
    :u8
    ok          = 0
    bad_psk     = 1
    bad_ticket  = 2  # binder ok but kind=agent presented an invalid auth ticket
    no_identity = 3  # binder ok but no identity union present (fail-closed)

# PskAuthRequest is the merged PSK + identity first message.
# binder_len == 0 means no PSK is configured (dev mode); otherwise 64 bytes
# (HMAC-SHA512 over the objproto transcript). role selects which hello type
# is present. On-wire: [0x45] + PskAuthRequest(brgen-encoded).
format PskAuthRequest:
    binder_len :u16
    binder :[binder_len]u8
    role :AuthRole
    match role:
        AuthRole.client => client_hello :ClientHello
        AuthRole.runner => runner_hello :RunnerHello

# PskAuthResponse is the server's accept/reject for a PskAuthRequest.
# On-wire: [0x45] + PskAuthResponse(brgen-encoded).
format PskAuthResponse:
    status :PskAuthStatus

format TaskID:
    id :[16]u8

format AssignTask:
    # Server-initiated send-stream id; runner reads AssignTaskBody bytes
    # from this stream until EOF, then decodes. 0 = no stream available
    # (server too constrained to allocate); runner should NACK / drop.
    #
    # Streamed instead of inline so long prompts don't blow path MTU on
    # UDP transport — see
    # docs/superpowers/specs/2026-05-09-udp-dualstack-design.md §12.1.
    #
    # task_id is also kept inline so the runner can correlate the
    # incoming stream-id with a TaskID without round-tripping through
    # a partial AssignTaskBody read.
    task_id :TaskID
    stream_id :u64

# AssignTaskBody carries the actual assignment payload. Server encodes
# this and writes it to the trsf send-stream referenced by
# AssignTask.stream_id; runner decodes after reading the full stream.
format AssignTaskBody:
    auth_ticket :[16]u8
    repo_path_len :u16
    repo_path :[repo_path_len]u8
    prompt_len :u32
    prompt :[prompt_len]u8
    extra_args :ClaudeArgs
    resume_conversation :u1
    reserved :u7
    # agent_profile: same semantics as SubmitRequest.agent_profile.
    agent_profile_len :u8
    agent_profile :[agent_profile_len]u8

format CancelTask:
    task_id :TaskID

# X11Forward carries the data needed to forward X11 to the client's local X
# server: the display number N (app sees DISPLAY=127.0.0.1:N -> TCP 6000+N) and
# the client's MIT-MAGIC-COOKIE-1 value (raw bytes, typically 16). Embedded
# conditionally in OpenInteractiveRequest and OpenExecRunnerRequest under
# `if x11_enabled == 1` so no bytes appear on the wire when X11 is off.
format X11Forward:
    display :u16
    cookie_len :u16
    cookie :[cookie_len]u8

format OpenExecRunnerRequest:
    task_id :TaskID
    auth_ticket :[16]u8
    repo_path_len :u16
    repo_path :[repo_path_len]u8
    stream_id :u64    # bidi stream the server has just created toward this
                      # runner; runner looks it up via
                      # Transport.GetBidirectionalStream(id) and feeds it to
                      # exec.ExecuteCommand for an interactive PTY claude.
    extra_args :ClaudeArgs
    x11_enabled :u1   # relayed from OpenInteractiveRequest.x11_enabled
    resume_conversation :u1 # relayed from OpenInteractiveRequest.resume_conversation
    # relayed from OpenInteractiveRequest.event_stream: run the profile's
    # stream adapter rather than the agent under a PTY. Mutually exclusive with
    # x11_enabled, which is a terminal concept.
    event_stream :u1
    reserved :u5
    # agent_profile: relayed from OpenInteractiveRequest.agent_profile /
    # AssignTaskBody.agent_profile.
    agent_profile_len :u8
    agent_profile :[agent_profile_len]u8
    if x11_enabled == 1:
        x11 :X11Forward  # relayed verbatim from OpenInteractiveRequest.x11

format TaskWakeRequest:
    task_id :TaskID

# RunnerHelloResponse is sent by the server immediately after a successful
# RunnerHello. your_runner_id is the canonical RunnerID the server uses to
# key this runner in its registry / agentboard ticket store. The runner
# stores this and injects it as HARNESS_RUNNER_ID for spawned agents so the
# agent's bridge Hello (runner_id, task_id, ticket) matches what the server
# registered. The peer transport's ConnectionID is symmetric and surfaces
# the peer's ID, not the runner's own — so the runner cannot derive this
# value locally.
format RunnerHelloResponse:
    your_runner_id :RunnerID

format TaskAccepted:
    task_id :TaskID

format TaskStarted:
    task_id :TaskID
    worktree_dir_len :u16
    worktree_dir :[worktree_dir_len]u8

format TaskFinished:
    task_id :TaskID
    exit_code :i32
    error_message :[..]u8

format RunnerMessage:
    kind :RunnerMessageType
    match kind:
        RunnerMessageType.hello => hello :RunnerHello
        RunnerMessageType.task_accepted => task_accepted :TaskAccepted
        RunnerMessageType.task_started => task_started :TaskStarted
        RunnerMessageType.task_finished => task_finished :TaskFinished
        RunnerMessageType.heartbeat => ..
        RunnerMessageType.establish_relay_response => establish_relay_response :EstablishRelayResponse
        RunnerMessageType.request_chained_relay => request_chained_relay :RequestChainedRelay
        RunnerMessageType.remote_forward_conn => remote_forward_conn :RemoteForwardConn
        RunnerMessageType.remote_forward_bind_result => remote_forward_bind_result :RemoteForwardBindResult
        RunnerMessageType.exec_run_finished => exec_run_finished :ExecRunFinished
        .. => error("Unexpected message")

format RunnerRequest:
    kind :RunnerRequestType
    match kind:
        RunnerRequestType.assign_task => assign_task :AssignTask
        RunnerRequestType.cancel_task => cancel_task :CancelTask
        RunnerRequestType.open_exec   => open_exec   :OpenExecRunnerRequest
        RunnerRequestType.runner_hello_response => runner_hello_response :RunnerHelloResponse
        RunnerRequestType.task_wake => task_wake :TaskWakeRequest
        RunnerRequestType.open_file_transfer => open_file_transfer :RunnerOpenFileTransferRequest
        RunnerRequestType.list_files         => list_files         :RunnerListFilesRequest
        RunnerRequestType.establish_relay    => establish_relay    :EstablishRelayRequest
        RunnerRequestType.chained_relay_response => chained_relay_response :ChainedRelayResponse
        RunnerRequestType.open_port_forward => open_port_forward :RunnerOpenPortForwardRequest
        RunnerRequestType.close_port_forward => close_port_forward :ClosePortForwardRequest
        RunnerRequestType.git_query => git_query :RunnerGitQueryRequest
        RunnerRequestType.open_exec_run => open_exec_run :RunnerExecRunRequest
        RunnerRequestType.close_exec_run => close_exec_run :CloseExecRunRequest

enum TaskControlKind:
    :u8
    submit
    list
    cancel
    prune_tasks
    get_task_log
    open_interactive
    client_hello
    attach_session
    open_file_transfer
    list_files
    dial_runner
    open_port_forward
    notify
    permission_denied
    list_conns      # appended (keeps existing ordinals stable): snapshot list of
                    # live objproto connections. Requires info_global; confined
                    # tasks see only their own subtree.
    board_topics    # list all known agentboard topics (names + metadata)
    board_read      # read messages from a topic (returns stream_id for content)
    board_purge     # purge a single message (by seq) from a topic
    whoami          # report the caller's own principal + enforced capability set
                    # (no cap required: self-introspection of THIS connection's
                    # server-resolved identity, not another task's record)
    await_idle      # one-shot: fire when an interactive session's PTY output
                    # goes quiescent (see AwaitIdleRequest). Requires NO
                    # capability: it reports last_output_at, which `ls` already
                    # returns to any caller that can see the task at all. Only
                    # sink=notify adds a gate, and it is `notify` — see
                    # AwaitIdleSink.
    register_port_forward   # register a -L/-R forward; returns forward_id + control stream
    list_port_forwards      # enumerate the caller's visible registrations
    kill_port_forward       # close one registration by id
    git_query               # read-only git log/diff/show/status for a task.
                            # Requires file_read. Unlike open_file_transfer /
                            # list_files this is NOT restricted to Running /
                            # Detached tasks: a terminal task's work stays
                            # reachable through refs/heads/harness/<taskID>.
    board_subscribers       # list each task's agentboard subscription set,
                            # optionally narrowed to the tasks a publish to one
                            # topic would reach. Requires info_global.
    set_caps                # operator-only: rewrite a live task's caps + scope.
                            # Gated on the caller having NO principal task, not
                            # on a capability bit — a bit authorising "rewrite
                            # capabilities" grants itself all on first use and
                            # spawn-time intersection can never claw it back.
    set_parent              # operator-only: re-point a live task's parent link,
                            # or swap it with its current parent. Gated on the
                            # caller having NO principal task, not on a
                            # capability bit — same self-amplification argument
                            # as set_caps: a task able to re-point parents would
                            # adopt any victim under itself and inherit that
                            # victim's whole subtree as a target set, and
                            # spawn-time intersection can never claw that back.
    open_exec_run           # run one argv in a task's WORKTREE as its own
                            # process, out of band from the session's PTY.
                            # Requires exec_run. Like git_query and unlike
                            # open_file_transfer, NOT restricted to Running /
                            # Detached: the gate is whether the worktree
                            # DIRECTORY is still there, and a task that ended
                            # with uncommitted work keeps it.
    exec_run_list           # enumerate running execs the caller can see
    exec_run_kill           # stop one running exec by id
    board_retract           # withdraw ONE retained message (by seq) from every
                            # agent-facing path while leaving it readable on the
                            # operator surfaces. Requires purge — the same bit
                            # board_purge takes, because anything it can reach,
                            # purge can already reach and destroy outright; this
                            # is the gentler half of that authority, not a new
                            # one. Distinct from the agentboard RetractRequest,
                            # which takes no capability and is gated on
                            # authorship instead.
    open_forward_tap        # appended (keeps existing ordinals stable): attach
                            # to one port forward and receive the bytes crossing
                            # it, live, as ForwardTapRecord. Requires
                            # forward_tap AND that the forward is visible to the
                            # caller. Nothing is recorded server-side — a tap
                            # sees only what crosses after it opens.

# ClientKind tags the kind of caller that opened a TaskControl session.
# `agent` is an in-task harness-cli that proves its identity via agent_info;
# operator surfaces use cli/tui/webui and carry no agent_info.
enum ClientKind:
    :u8
    unspecified
    cli
    tui
    webui
    agent

# AgentInfo is the per-task agent credential, mirroring the (now-removed)
# agentboard AgentBridgeHello triple. Validated server-side via the agentboard
# Registry. hostname is length-prefixed (0 len = absent).
format AgentInfo:
    runner_id :RunnerID
    task_id :TaskID
    auth_ticket :[16]u8
    hostname_len :u8
    hostname :[hostname_len]u8

format ClientHello:
    kind :ClientKind
    if kind == ClientKind.agent:
        agent_info :AgentInfo

enum ClientHelloStatus:
    :u8
    ok = "ok"
    bad_ticket
    unknown_task
    runner_mismatch

format ClientHelloResponse:
    status :ClientHelloStatus

# admin → server: dial out to this runner endpoint and complete registration.
# Used in environments where ACL blocks runner→server outbound; server initiates
# the TCP/UDP connect instead.
format DialRunnerRequest:
    target :RunnerID
    via    :RunnerID

enum DialRunnerStatus:
    :u8
    ok             = "ok"
    dial_failed    = "dial_failed"
    psk_failed     = "psk_failed"
    hello_timeout  = "hello_timeout"
    invalid_target = "invalid_target"
    via_not_found      = "via_not_found"
    via_relay_failed   = "via_relay_failed"

format DialRunnerResponse:
    status :DialRunnerStatus

# server → proxy_runner: please prepare to relay between me and target at slot_id.
# Sent on the existing PSK-validated server↔proxy_runner registered conn.
format EstablishRelayRequest:
    target  :RunnerID
    slot_id :u16

enum EstablishRelayStatus:
    :u8
    ok                       = "ok"
    target_dial_failed       = "target_dial_failed"
    slot_collision           = "slot_collision"
    set_proxy_failed         = "set_proxy_failed"
    invalid_target           = "invalid_target"

format EstablishRelayResponse:
    status :EstablishRelayStatus

# runner → server: "before I install my local SetProxy for an agent Phase B
# ceremony, walk my chain on your side and make sure every upstream hop
# has the right SetProxy entry for slot_id."
format RequestChainedRelay:
    slot_id :u16

enum ChainedRelayStatus:
    :u8
    ok                  = "ok"
    direct              = "direct"             # no chain — runner is registered direct
    slot_collision      = "slot_collision"
    hop_setup_failed    = "hop_setup_failed"
    chain_unwalkable    = "chain_unwalkable"
    another_in_flight   = "another_in_flight"

format ChainedRelayResponse:
    status :ChainedRelayStatus

# Phase B: agent ↔ runner negotiated-proxy ceremony.
# Agent sends ProxyRequest as the first app message after peer.Dial-ing the
# runner; runner replies with ProxyEstablishResponse. See spec
# docs/superpowers/specs/2026-05-22-server-mode-runner-reverse-dial-design.md Phase B.

format ProxyRequest:
    task_id :TaskID

enum ProxyEstablishStatus:
    :u8
    ok                   = "ok"
    id_collision         = "id_collision"
    server_not_connected = "server_not_connected"
    unknown_task         = "unknown_task"
    internal_error       = "internal_error"     # runner-side SetProxy or other internal failure; agent should NOT retry

format ProxyEstablishResponse:
    status :ProxyEstablishStatus

enum ProxyControlKind:
    :u8
    request
    establish_response

format ProxyControl:
    kind :ProxyControlKind
    match kind:
        ProxyControlKind.request              => request              :ProxyRequest
        ProxyControlKind.establish_response   => establish_response   :ProxyEstablishResponse

# Phase B: server → runner marker sent immediately after server-side
# DoECDHHandshake completes (reverse-dial path). Lets the runner's accept
# handler discriminate "server conn" vs "agent conn" without timing heuristics.
# version is reserved for forward-compatible feature negotiation; the runner
# logs unknown versions and proceeds.
format DialGreeting:
    version :u8

format ListQuery:
    query :[..]u8 # currently opaque

format RunnerID:
    transport_len :u8
    transport :[transport_len]u8
    ip_addr_len :u8
    ip_addr_len == 0 || ip_addr_len == 4 || ip_addr_len == 16
    ip_addr :[ip_addr_len]u8
    port :u16
    unique_number :u16

enum TaskStatus:
    :u8
    Queued
    Running
    Succeeded
    Failed
    Cancelled
    Detached

# TaskKind distinguishes how the task was requested.
#  - oneshot:     submitted via SubmitRequest, claude runs with -p prompt and exits
#  - interactive: opened via OpenInteractiveRequest, claude runs under a PTY
#                 spliced bytewise to the requesting client. Has empty prompt.
# Without this field the TUI has to infer the kind from len(prompt)==0,
# which is brittle (a freshly-stubbed TaskInfo from TaskStatusEvent would
# spuriously look interactive until the next List snapshot fills the prompt).
enum TaskKind:
    :u8
    oneshot
    interactive
    # stream is the event-stream kind: multi-turn like interactive, but its
    # data plane is structured events rather than PTY bytes. It rides the SAME
    # open-exec machinery — one server-allocated bidi stream carrying
    # exec/frame Stdout/Stdin frames — so the payload inside those frames is
    # the adapter's neutral NDJSON instead of terminal output. Appending an
    # enum VALUE is decode-safe (scope_wire_test pins that an unknown value
    # decodes and renders numerically); nothing about the byte layout moves.
    stream

enum RunnerStatus:
    :u8
    Offline
    Idle
    Busy

# ActiveTaskRef records a currently-running task assigned to a runner.
format ActiveTaskRef:
    task_id :TaskID
    repo_path_len :u16
    repo_path :[repo_path_len]u8

# RunnerInfo replaces the old single-repo shape with multi-root and active-tasks.
format RunnerInfo:
    id :RunnerID
    hostname_len :u8
    hostname :[hostname_len]u8
    # Relayed from RunnerHello.goos, so an operator can see which runners are
    # which without opening a session on one.
    goos_len :u8
    goos :[goos_len]u8
    status :RunnerStatus
    max_tasks :u16
    allowed_roots_len :u8
    allowed_roots :[allowed_roots_len]AllowedRoot
    active_tasks_len :u16
    active_tasks :[active_tasks_len]ActiveTaskRef
    connected_at :u64  # unix nano
    last_seen :u64
    # peer identity (mirrors RunnerHello): agent binary basename + whether the
    # runner injects .claude/{settings.json,skills}. Echoed by the server.
    agent_bin_len :u8
    agent_bin :[agent_bin_len]u8
    skills_injected :u1
    reserved :u7
    # named agent profiles this runner can launch a session under (mirrors
    # RunnerHello.agent_profiles). Echoed by the server.
    agent_profiles_len :u8
    agent_profiles :[agent_profiles_len]AgentProfileName

format TaskInfo:
    id :TaskID
    status :TaskStatus
    kind :TaskKind
    origin_kind :ClientKind   # which kind of client submitted this task (cli / tui / webui).
                              # Set by the server from the connection's last ClientHello.
                              # Stays Unspecified for tasks created before any hello.
    resumed_by_kind :ClientKind  # kind of the connection that performed the
                              # LATEST resume; Unspecified until first resumed.
                              # origin_kind stays the original creator.
    creator_task_id :TaskID   # task id of the AGENT principal that created this
                              # task (kind=agent connection). All-zero for
                              # operator-created tasks. Set at Create; unchanged
                              # on resume. Single parent link.
    capabilities :Capability  # the task's server-enforced capability set
    repo_path_len :u16
    repo_path :[repo_path_len]u8
    assigned_to :RunnerID
    worktree_dir_len :u16
    worktree_dir :[worktree_dir_len]u8
    created_at :u64
    started_at :u64
    ended_at :u64
    exit_code :i32
    prompt_len :u32
    prompt :[prompt_len]u8
    error_len :u32
    error_message :[error_len]u8
    is_attached :u1       # client tuiStream is currently spliced
    # skills_injected mirrors RunnerInfo.skills_injected for the runner this task
    # was ASSIGNED to, stamped at assign time so it survives that runner going
    # offline. It is carried on the task rather than read off RunnerInfo because
    # a confined caller (no info_global, not operator) receives ZERO runners by
    # design — see handleList — and a confined agent deciding whether a peer
    # follows the agentboard conventions is exactly who needs this bit.
    #
    # DECLARATION, not observation: it says the runner is configured to inject
    # (!--no-worktree || --force-inject-harness-settings), while the write itself
    # is non-fatal in runner/session.go. 0 on a Queued task — nothing has been
    # assigned yet — which is why it must not be read as "this agent is bare".
    skills_injected :u1
    reserved :u6
    ring_buffer_bytes :u64    # current bytes buffered (0 for oneshot tasks —
                              # every interactive session has a ring)
    last_output_at :u64   # unix nanos (SERVER clock) of the last Stdout/Stderr
                          # frame the server received from this session's runner
                          # stream. 0 = not an interactive session, no output
                          # yet, or the session mux is already gone. Populated
                          # at List time from the live SessionMux (not stored).
    output_idle_ms :u64   # ms elapsed between last_output_at and List time,
                          # computed on the server clock so cross-host clock
                          # skew cannot distort it. Meaningful ONLY when
                          # last_output_at > 0 (otherwise 0, which would be
                          # ambiguous with "0ms ago"). Consumers must use this,
                          # not now()-last_output_at, to derive busy/idle.
    agent_profile_len :u8   # named agent profile this task was launched under
    agent_profile :[agent_profile_len]u8  # (empty = runner default).
    scope :TaskScope        # which tasks this task's capabilities may target
    overrides_len :u8   # per-capability scope overrides; masks pairwise disjoint
    overrides     :[overrides_len]ScopeOverride
    # Observers attached to this task's live session, split by what they can DO:
    # a viewer's input is discarded, a cowriter's is forwarded to the runner.
    # The CONTROL attach is neither — is_attached carries that, and only the
    # control attach moves the task between Running and Detached. So a task
    # being watched through the WebUI preview reads Detached with viewers > 0,
    # and "Detached" must not be read as "nobody is looking".
    #
    # Live-only, like last_output_at/output_idle_ms: populated at List time from
    # the SessionMux, never stored and never in the WAL, because the observer
    # set of an ended session is not a fact that survives it. Both are 0 when
    # the task has no live session at all — the status column is what separates
    # that from "a live session nobody is observing".
    viewers :u16
    cowriters :u16
    # exec_count is how many out-of-band execs are running against this
    # task's worktree right now. Live-only like the observer counts above,
    # populated at List time from the server's exec registry, and reported
    # AT ZERO for the same reason they are: an elided 0 reads as "this row
    # does not report execs", which is the ambiguity the counts exist to
    # remove. It is 0 for a task with no worktree to run anything in.
    exec_count :u16

format ListResult:
    # Server-initiated send-stream id; client reads ListResultBody bytes
    # from this stream until EOF, then decodes. 0 = no stream available
    # (e.g. server too constrained to allocate); client treats as error.
    #
    # Streamed instead of inline so the response fits comfortably in any
    # path MTU on UDP transport — see
    # docs/superpowers/specs/2026-05-09-udp-dualstack-design.md §12.1.
    stream_id :u64

# ListResultBody carries the actual runners + tasks payload. Server
# encodes this and writes it to the trsf send-stream referenced by
# ListResult.stream_id; client decodes after reading the full stream.
format ListResultBody:
    runners_len :u16
    runners :[runners_len]RunnerInfo
    tasks_len :u16
    tasks :[tasks_len]TaskInfo

# RunnerSelectorKind tags which selector variant is active.
enum RunnerSelectorKind:
    :u8
    any          # no preference; server picks
    by_runner_id # pin to a specific RunnerID
    by_hostname  # pin to a runner with a matching hostname
    by_ip        # pin to a runner at a specific IP address

# Hostname selector: the hostname string the runner advertised in RunnerHello.
format Hostname:
    name_len :u8
    name :[name_len]u8

# IPAddr selector: raw IPv4 (4 bytes) or IPv6 (16 bytes).
format IPAddr:
    addr_len :u8
    addr_len == 4 || addr_len == 16
    addr :[addr_len]u8

# RunnerSelector is the tagged union embedded in SubmitRequest and
# OpenInteractiveRequest that lets a client pin a task to a specific runner.
format RunnerSelector:
    kind :RunnerSelectorKind
    match kind:
        RunnerSelectorKind.any          => ..
        RunnerSelectorKind.by_runner_id => runner_id :RunnerID
        RunnerSelectorKind.by_hostname  => hostname  :Hostname
        RunnerSelectorKind.by_ip        => ip_addr   :IPAddr

format SubmitRequest:
    repo_path_len :u16
    repo_path :[repo_path_len]u8
    selector :RunnerSelector
    prompt_len :u32
    prompt :[prompt_len]u8
    extra_args :ClaudeArgs
    # requested_caps is a Capability bitmask the spawning principal requests for
    # this task. The server computes caps_child = caps_creator ∩ requested_caps.
    # Use Capability.all (0xfff) to inherit the creator's full set (the default
    # when no explicit confinement is desired). A zero value grants nothing.
    requested_caps :Capability
    # resume only: 1 = set caps to caps_resumer ∩ requested_caps on resume; 0 = keep persisted. Ignored on create.
    resume_caps_override :u1
    # resume only: 1 = ask the runner to resume the agent's own conversation
    # state in addition to reusing the harness task/worktree. The runner maps
    # this intent to the configured agent CLI (for Claude Code, --continue).
    resume_conversation :u1
    # resume only: 1 = write scope onto the resumed task (attenuated); 0 =
    # keep its persisted scope. Independent of resume_caps_override — the two
    # halves of authority re-grant separately, same shape as SetCapsRequest's
    # caps_present/scope_present. Ignored on create (scope always applies to
    # a fresh task; its zero value IS the subtree default).
    scope_present :u1
    reserved :u5
    # resume_task_id, when all-zero, means "create a new task". When non-zero,
    # the server looks up that TaskID, validates it is in a terminal state
    # (Succeeded / Failed / Cancelled), and re-queues it under the SAME id so
    # the runner re-attaches its worktree to the retained `harness/<id>` branch
    # — claude's project key (~/.claude/projects/<cwd-hash>/) therefore lines
    # up with the previous run, which is what makes `--claude-arg --resume
    # <session-uuid>` actually work after the 2.1.123 picker regression.
    resume_task_id :TaskID
    # agent_profile selects a named agent profile advertised by the target
    # runner (see AgentProfileName / RunnerHello.agent_profiles). Empty =
    # runner default (--claude-bin).
    agent_profile_len :u8
    agent_profile :[agent_profile_len]u8
    # scope bounds which tasks this task's capabilities may target; see
    # TaskScope. Omitted (zero) = subtree. Never inherit-the-creator: an
    # operator is global, so an inheriting default would hand global to every
    # task the operator spawns.
    scope :TaskScope
    overrides_len :u8   # per-capability scope overrides; masks pairwise disjoint
    overrides     :[overrides_len]ScopeOverride

# SubmitStatus indicates the outcome of a SubmitRequest.
enum SubmitStatus:
    :u8
    ok                  = "ok"
    no_runner           = "no_runner"
    ambiguous_runner    = "ambiguous_runner"
    pinned_not_found    = "pinned_not_found"
    internal_error      = "internal_error"
    # resume_not_found / resume_not_terminal are returned when resume_task_id
    # is set but the target either doesn't exist or is still active (Queued /
    # Running / already mid-resume). Concurrent resume attempts on the same
    # ID land here — the second caller sees resume_not_terminal because the
    # first transitioned the status back to Queued under TaskStore.mu.
    resume_not_found    = "resume_not_found"
    resume_not_terminal = "resume_not_terminal"
    # requested agent_profile is not among the target runner's advertised
    # AgentProfileName list.
    profile_unavailable = "profile_unavailable"
    # requested scope is not a subset of the spawner's effective scope. Named
    # rather than silently clamped: a task whose scope differs from the one the
    # caller wrote, with nothing saying so, is the failure mode this rejects.
    scope_not_permitted = "scope_not_permitted"

# SubmitResponse replaces the old bare task_id with a status + optional error.
format SubmitResponse:
    status :SubmitStatus
    task_id :TaskID        # zero when status != ok
    error_msg_len :u16
    error_msg :[error_msg_len]u8

format PruneTasksRequest:
    before_ts :u64    # unix nano cutoff; terminal tasks with EndedAt < this are removed
                      # ignored when task_ids_len > 0
    task_ids_len :u16
    task_ids :[task_ids_len]TaskID    # when non-empty: prune only these ids, ignoring before_ts
    force :u8                          # 1 = also prune ids whose tasks are still active (Queued/Running/Detached)

format PruneTasksResponse:
    removed :u32
    skipped_active :u32    # id-mode only: tasks not pruned because still active and force=0
    skipped_missing :u32   # id-mode only: ids that were not present in the server's task store

format GetTaskLogRequest:
    task_id :TaskID

format GetTaskLogResponse:
    found :u8         # 0 = no log file on server, 1 = found
    stream_id :u64    # 0 if !found; otherwise the unidirectional send-stream
                      # the server creates and writes the file content into
                      # (closed with EOF when complete). Client reads via
                      # trsf.Transport.GetReceiveStream.

enum BoardStatus:
    :u8
    ok
    not_found

format BoardTopicsRequest:
    request_id :u32

format BoardTopicRow:
    name_len :u16
    name :[name_len]u8
    last_seq :u64
    last_published_at_unix_ms :u64
    msg_count :u16
    # retracted_count is how many withdrawn messages the topic still holds for
    # operator audit (see BoardMessageRow.retracted). They are deliberately NOT
    # folded into msg_count: msg_count answers "how much would a subscriber
    # receive", which is the number every agent-facing path reports, and a
    # topic whose ring is empty but whose withdrawn log is not must not read as
    # if it still had live traffic.
    retracted_count :u16

format BoardTopicsResponse:
    request_id :u32
    topics_len :u16
    topics :[topics_len]BoardTopicRow

format BoardReadRequest:
    request_id :u32
    topic_len :u16
    topic :[topic_len]u8

# RetractedBy names WHICH authority check withdrew a message, because there are
# now two and they answer different questions for a reader of the board.
# Meaningful only on a row whose `retracted` bit is 1 — like
# retracted_at_unix_ms, its zero on a live row is padding, not a claim that the
# author withdrew anything.
enum RetractedBy:
    :u8
    # The message's own sender withdrew it: agentboard RetractRequest, gated on
    # authorship (agentboard/topic.go retract).
    author    = 0, "author"
    # A holder of Capability_Purge withdrew somebody else's message:
    # TaskControlKind.board_retract. Not necessarily an operator — a task
    # granted `purge` can do this too, which is why the value names the check
    # that passed rather than a kind of caller.
    purge_cap = 1, "purge_cap"

format BoardMessageRow:
    seq :u64
    # See agentboard/agentboard.bgn SendRequest.in_reply_to — same value,
    # 0 when the message is not a reply.
    in_reply_to :u64
    from_task :TaskID
    from_hostname_len :u8
    from_hostname :[from_hostname_len]u8
    # from_agent_profile is the agent profile the sending task was running under
    # at publish time. See agentboard/agentboard.bgn
    # DeliveredMessage.from_agent_profile — same value, same freeze-at-publish
    # semantics. Empty = the server could not attribute a runtime.
    from_agent_profile_len :u8
    from_agent_profile :[from_agent_profile_len]u8
    received_at_unix_ms :u64
    size :u32
    # retracted marks a withdrawn message. A withdrawn message has left every
    # agent-facing path (deliver / inbox / wait / read_seq / list_retained) and
    # survives only here, so that a retract in seconds cannot shrink the window
    # a human has to audit what was said. It ages out with the topic like
    # anything else — this is a logical delete, not a durable ledger.
    retracted :u1
    reserved  :u7
    retracted_at_unix_ms :u64   # 0 unless retracted is 1
    # WHO withdrew it. Both fields are meaningless unless retracted is 1.
    #
    # retracted_by names the authority check that passed; retracted_by_task is
    # the task that made the call, and equals from_task for an author retract.
    # It is all-zero when the caller had no principal task at all — an operator
    # client (cli/tui/webui) holds its capabilities directly, not through a
    # task, so there is no id to report. Read it with the enum, never alone: a
    # zero id under `purge_cap` means "an operator client", while a zero id
    # under `author` is just a live row's padding.
    retracted_by :RetractedBy
    retracted_by_task :TaskID
    # reply_to_topic is where a reply to THIS message is routed — the
    # destination its SENDER declared. See agentboard/agentboard.bgn
    # SendRequest.reply_to_topic. Empty = none declared, so a reply goes to the
    # sender's own chat.<short-id>. An operator needs it to answer "where did
    # the answer go", which is otherwise unanswerable: the routing happens
    # server-side off the parent and appears nowhere in either message's text.
    reply_to_topic_len :u16
    reply_to_topic :[reply_to_topic_len]u8

format BoardReadResponse:
    request_id :u32
    status :BoardStatus
    stream_id :u64
    msgs_len :u16
    msgs :[msgs_len]BoardMessageRow

format BoardSubscribersRequest:
    request_id :u32
    # Empty topic = no filter: every task known to the board.
    topic_len :u16
    topic :[topic_len]u8

format SubscriptionPattern:
    name_len :u16
    name :[name_len]u8
    # shown is the highest seq the automatic injection path has given this task
    # for this topic; 0 when nothing has been advanced past. pending is how many
    # retained messages sit above it.
    #
    # Together they make the delivery position READABLE. It used to be a file on
    # the runner host (~/.cache/harness/agent-cursor-<task>) that no operator
    # surface showed, which is why the shipped skill told agents to guess at a
    # desync and re-read everything. Now `board subscribers` answers it.
    #
    # A topic under a live synchronous wait appears here like any other
    # subscription, because for the duration of that wait the task really is a
    # subscriber.
    shown :u64
    pending :u32

format BoardSubscriberRow:
    task :TaskID
    # hostname is empty for a task that is registered (so its chat.<short-id>
    # is seeded) but has not yet run a harness-cli command — see
    # agentboard.SubscriberRow. That is a real state, not missing data.
    hostname_len :u8
    hostname :[hostname_len]u8
    agent_profile_len :u8
    agent_profile :[agent_profile_len]u8
    patterns_len :u16
    patterns :[patterns_len]SubscriptionPattern

format BoardSubscribersResponse:
    request_id :u32
    rows_len :u16
    rows :[rows_len]BoardSubscriberRow

format BoardPurgeRequest:
    request_id :u32
    topic_len :u16
    topic :[topic_len]u8
    seq :u64

format BoardPurgeResponse:
    request_id :u32
    status :BoardStatus
    purged :u16

# BoardRetractRequest withdraws ONE retained message. seq is required and must
# be non-zero: purge's "seq 0 means the whole topic" shorthand is deliberately
# NOT inherited, so that a mistyped command costs one message instead of a
# topic. The topic is named rather than searched for because the caller reached
# the seq through board_read, which is per-topic.
format BoardRetractRequest:
    request_id :u32
    topic_len :u16
    topic :[topic_len]u8
    seq :u64

# not_found covers all of: unknown topic, unknown seq, a seq already withdrawn,
# and seq 0. They are one answer on purpose — the same collapse RetractStatus
# makes in agentboard.bgn — so the reply cannot be used to probe what a topic
# holds.
format BoardRetractResponse:
    request_id :u32
    status :BoardStatus

format OpenInteractiveRequest:
    repo_path_len :u16
    repo_path :[repo_path_len]u8
    selector :RunnerSelector
    extra_args :ClaudeArgs
    # requested_caps: same semantics as SubmitRequest.requested_caps.
    requested_caps :Capability
    # See SubmitRequest.resume_task_id — same semantics, applied to the
    # interactive path (PTY claude with empty prompt).
    # Every interactive open is a detachable session (detach on disconnect,
    # reattach from any operator client) — the legacy kill-on-disconnect
    # variant was removed along with its wire bit.
    x11_enabled :u1   # 1 = client requested X11 forwarding; gates the
                      # conditional block below. Incompatible with the -d
                      # spawn-only mode (a live client must host the tunnel).
    # resume only: 1 = set caps to caps_resumer ∩ requested_caps on resume; 0 = keep persisted. Ignored on create.
    resume_caps_override :u1
    # resume only: 1 = ask the runner to resume the agent's own conversation
    # state in addition to reusing the harness task/worktree. The runner maps
    # this intent to the configured agent CLI (for Claude Code, --continue).
    resume_conversation :u1
    # resume only: same semantics as SubmitRequest.scope_present.
    scope_present :u1
    # 1 = open this session as TaskKind.stream: the runner spawns the profile's
    # stream adapter instead of the agent under a PTY, and the frames carry
    # neutral NDJSON. Takes a reserved bit rather than a new request type,
    # because everything else about opening a session — caps, scope, the
    # server-allocated stream, the session mux that owns it — is identical.
    event_stream :u1
    reserved :u3
    resume_task_id :TaskID
    # agent_profile: same semantics as SubmitRequest.agent_profile.
    agent_profile_len :u8
    agent_profile :[agent_profile_len]u8
    # scope: same semantics as SubmitRequest.scope.
    scope :TaskScope
    overrides_len :u8   # per-capability scope overrides; masks pairwise disjoint
    overrides     :[overrides_len]ScopeOverride
    # X11 block is on the wire ONLY when x11_enabled == 1 (no invisible bytes
    # when disabled).
    if x11_enabled == 1:
        x11 :X11Forward

enum OpenInteractiveStatus:
    :u8
    ok  = "ok"
    no_runner_for_repo  = "no_runner_for_repo"
    runner_busy         = "runner_busy"
    ambiguous_runner    = "ambiguous_runner"
    pinned_not_found    = "pinned_not_found"
    # A requested/resolved agent profile is advertised by no runner serving the
    # repo (mirrors SubmitStatus.profile_unavailable on the oneshot path).
    profile_unavailable = "profile_unavailable"
    internal_error      = "internal_error"
    # See SubmitStatus — same resume semantics for the interactive path.
    resume_not_found    = "resume_not_found"
    resume_not_terminal = "resume_not_terminal"
    # See SubmitStatus.scope_not_permitted. This response carries no error_msg
    # field, so the status is the whole answer and the client supplies the
    # offending ids from the scope it sent.
    scope_not_permitted = "scope_not_permitted"

# One candidate runner returned when an OpenInteractive request is ambiguous
# (>=2 runners tie on longest-prefix roots score under an Any selector). `cid`
# is ConnectionID.String() — the exact string the --runner selector accepts, so
# a client pins the retry with SelectorOpts{Runner: cid}. Carrying the string
# (not a typed RunnerID) also sidesteps the zero-value RunnerID encoder panic.
format RunnerCandidate:
    cid_len          :u16
    cid              :[cid_len]u8
    hostname_len     :u16
    hostname         :[hostname_len]u8
    matched_root_len :u16
    matched_root     :[matched_root_len]u8
    active_tasks     :u16
    max_tasks        :u16
    # requested agent profile this candidate advertises (empty = not
    # requested / runner default). Lets a client's ambiguous-runner picker
    # show which candidates actually support the profile the caller asked for.
    profile_len      :u16
    profile          :[profile_len]u8

format OpenInteractiveResponse:
    status :OpenInteractiveStatus
    task_id :TaskID    # populated when status == 0
    stream_id :u64     # populated when status == 0. Bidirectional stream the
                       # server opens toward the client; client looks it up via
                       # Transport.GetBidirectionalStream(id) and wraps it in
                       # exec.NewCommandExecutionStream. Server splices this
                       # bytewise to a separate bidi stream it has also opened
                       # toward the runner — the runner is told about its end
                       # via RunnerRequest{open_exec, task_id, stream_id} and
                       # feeds it to exec.ExecuteCommand for an interactive
                       # PTY claude session.
    # Populated ONLY when status == ambiguous_runner: the runners that tied for
    # this repo. The client shows a picker and re-issues pinned to a chosen cid.
    if status == OpenInteractiveStatus.ambiguous_runner:
        candidates_len :u16
        candidates     :[candidates_len]RunnerCandidate

enum AttachMode:
    :u8
    control = "control"   # default (ordinal 0): sole writer + size authority; takeover among controls
    view    = "view"      # read-only observer; no input, no takeover
    cowrite = "cowrite"   # input-forwarding writer; keystrokes forwarded but resize stripped
                          # (NO size authority); non-takeover, coexists with one control + viewers

format AttachSessionRequest:
    task_id :TaskID
    mode :AttachMode
    replay_limit :u32   # 0 = unlimited (full ring, default); >0 = cap the replay
                        # to the last replay_limit bytes (rounded to a frame
                        # boundary). Only honored for observer attaches
                        # (view/cowrite) — control reattach always gets the full
                        # ring. A monitoring grid pane shows only a small crop, so
                        # it requests a small limit instead of pulling ~1 MiB.

enum AttachSessionStatus:
    :u8
    ok                  = "ok"
    not_found           = "not_found"
    not_interactive     = "not_interactive"
    already_terminal    = "already_terminal"
    runner_unreachable  = "runner_unreachable"
    internal_error      = "internal_error"

format AttachSessionResponse:
    status :AttachSessionStatus
    stream_id :u64
    replay_bytes :u64
    # kind: the attached task's TaskKind, stated by the server because the
    # client cannot interpret the stream without it — terminal bytes
    # (interactive) and neutral NDJSON (stream) are indistinguishable from the
    # frames alone until it is too late to have asked. It must come from the
    # RESPONSE rather than from `ls`/snapshot because an attach may be
    # authorized for a caller whose visibility scope shows nothing
    # (`scope=none +exec_view:global`); the server knows the kind from the
    # task record either way. Meaningful only when status == ok; zero
    # otherwise (zero decodes as oneshot, which no attachable task is).
    #
    # Appending this field is a LAYOUT change on a RESPONSE, and the skew is
    # asymmetric — MEASURED 2026-08-21, after first writing the opposite:
    # an OLD client against a NEW server works (the client decode path is the
    # tolerant Decode, which leaves trailing bytes unread), while a NEW
    # client against an OLD server cannot decode the shorter arm. That
    # failure is routed to the waiting caller as cli.ErrResponseUndecodable;
    # before that routing it was a silent hang. Deploy server-first, as the
    # fleet rule already says.
    kind :TaskKind

# WhoAmIRequest carries no fields: the server resolves the caller's identity
# from the connection principal (the agent ticket recorded at hello), never
# from anything the client sends. A field-less body keeps the envelope honest.
format WhoAmIRequest:
    reserved :u8  # always 0; placeholder so the variant body is non-empty

# WhoAmIResponse reports what the SERVER enforces for THIS connection:
#   - principal_task_id: the caller's own task id; all-zero means an operator
#     connection (no confined principal → full authority).
#   - creator_task_id: the principal's spawner; all-zero when operator or a
#     top-level (operator-spawned) task.
#   - capabilities: the exact bitmask checked on every gated RPC (callerCaps).
format WhoAmIResponse:
    principal_task_id :TaskID
    creator_task_id   :TaskID
    capabilities      :Capability
    scope             :TaskScope
    overrides_len :u8   # per-capability scope overrides; masks pairwise disjoint
    overrides     :[overrides_len]ScopeOverride
# await_idle: one-shot idle-edge watch on an interactive session's PTY output.
# Fires when now - last_output >= threshold (byte-level quiescence; measured
# claude busy-side max gap is ~0.5s, so the 2500ms default has wide margin),
# or when the session stops first. A watcher fires exactly once, then is
# removed. Armed while already idle => fires immediately. Armed before any
# output (last_output==0) => waits for first output, then the edge.
enum AwaitIdleSink:
    :u8
    reply = 0                 # long-poll: the TaskControlResponse is delayed
                              # until the watcher fires
    notify = 1                # reply `armed` now; operator notification on fire
    board = 2                 # reply `armed` now; agentboard publish to `topic`
                              # on fire (JSON {"kind":"session_idle",...})

# NOTE: sink=notify without the `notify` capability is rejected via the shared
# permission_denied response, never via this enum. No other sink is gated.
enum AwaitIdleStatus:
    :u8
    fired = 0                 # idle edge observed
    armed = 1                 # watcher registered (sink=notify/board)
    session_stopped = 2       # session ended before the idle edge
    not_found = 3             # unknown task id or no live session mux
    bad_request = 4           # e.g. sink=board with empty topic, unknown sink

format AwaitIdleRequest:
    task_id :TaskID
    threshold_ms :u32         # 0 => server default (2500)
    sink :AwaitIdleSink
    topic_len :u16            # sink=board: agentboard topic to publish to
    topic :[topic_len]u8      # ignored for other sinks

format AwaitIdleResponse:
    status :AwaitIdleStatus
    last_output_at :u64       # unix nanos at decision time (0 if none)

format TaskControlRequest:
    kind :TaskControlKind
    request_id :u32
    match kind:
        TaskControlKind.submit => submit :SubmitRequest
        TaskControlKind.list => list :ListQuery
        TaskControlKind.cancel => cancel :CancelTask
        TaskControlKind.prune_tasks => prune :PruneTasksRequest
        TaskControlKind.get_task_log => get_log :GetTaskLogRequest
        TaskControlKind.open_interactive => open_interactive :OpenInteractiveRequest
        TaskControlKind.client_hello => client_hello :ClientHello
        TaskControlKind.attach_session => attach :AttachSessionRequest
        TaskControlKind.open_file_transfer => open_file_transfer :OpenFileTransferRequest
        TaskControlKind.list_files         => list_files         :ListFilesRequest
        TaskControlKind.dial_runner        => dial_runner        :DialRunnerRequest
        TaskControlKind.open_port_forward  => open_port_forward  :OpenPortForwardRequest
        TaskControlKind.notify              => notify             :NotifyRequest
        TaskControlKind.list_conns          => list_conns         :ConnListQuery
        TaskControlKind.board_topics => board_topics :BoardTopicsRequest
        TaskControlKind.board_read   => board_read   :BoardReadRequest
        TaskControlKind.board_purge  => board_purge  :BoardPurgeRequest
        TaskControlKind.board_subscribers => board_subscribers :BoardSubscribersRequest
        TaskControlKind.whoami       => whoami       :WhoAmIRequest
        TaskControlKind.await_idle   => await_idle   :AwaitIdleRequest
        TaskControlKind.register_port_forward => register_port_forward :RegisterPortForwardRequest
        TaskControlKind.list_port_forwards    => list_port_forwards    :PortForwardListQuery
        TaskControlKind.kill_port_forward     => kill_port_forward     :KillPortForwardRequest
        TaskControlKind.git_query             => git_query             :GitQueryRequest
        TaskControlKind.set_caps              => set_caps              :SetCapsRequest
        TaskControlKind.set_parent            => set_parent            :SetParentRequest
        TaskControlKind.open_exec_run         => open_exec_run         :ExecRunRequest
        TaskControlKind.exec_run_list         => exec_run_list         :ExecRunListRequest
        TaskControlKind.exec_run_kill         => exec_run_kill         :ExecRunKillRequest
        TaskControlKind.board_retract         => board_retract         :BoardRetractRequest
        TaskControlKind.open_forward_tap      => open_forward_tap      :OpenForwardTapRequest
        .. => error("Unexpected task")

# CancelResult replaces a bare u8 that every reply wrote as 0. ok stays 0, so
# the success byte is unchanged on the wire; no_such_task is the answer for a
# target outside the caller's scope, which is deliberately indistinguishable
# from a target that does not exist.
enum CancelResult:
    :u8
    ok           = 0, "ok"
    no_such_task = 1, "no_such_task"

format CancelStatus:
    status :CancelResult

format PermissionDeniedResponse:
    requested_kind :TaskControlKind
    required_cap   :Capability

format TaskControlResponse:
    kind :TaskControlKind
    request_id :u32
    match kind:
        TaskControlKind.submit => submit :SubmitResponse
        TaskControlKind.list => list :ListResult
        TaskControlKind.cancel => cancel :CancelStatus
        TaskControlKind.prune_tasks => prune :PruneTasksResponse
        TaskControlKind.get_task_log => get_log :GetTaskLogResponse
        TaskControlKind.open_interactive => open_interactive :OpenInteractiveResponse
        TaskControlKind.client_hello => client_hello :ClientHelloResponse
        TaskControlKind.attach_session => attach :AttachSessionResponse
        TaskControlKind.open_file_transfer => open_file_transfer :OpenFileTransferResponse
        TaskControlKind.list_files         => list_files         :ListFilesResponse
        TaskControlKind.dial_runner        => dial_runner        :DialRunnerResponse
        TaskControlKind.open_port_forward  => open_port_forward  :OpenPortForwardResponse
        TaskControlKind.notify              => notify             :NotifyResponse
        TaskControlKind.permission_denied  => permission_denied  :PermissionDeniedResponse
        TaskControlKind.list_conns          => list_conns         :ConnListResult
        TaskControlKind.board_topics => board_topics :BoardTopicsResponse
        TaskControlKind.board_read   => board_read   :BoardReadResponse
        TaskControlKind.board_purge  => board_purge  :BoardPurgeResponse
        TaskControlKind.board_subscribers => board_subscribers :BoardSubscribersResponse
        TaskControlKind.whoami       => whoami       :WhoAmIResponse
        TaskControlKind.await_idle   => await_idle   :AwaitIdleResponse
        TaskControlKind.register_port_forward => register_port_forward :RegisterPortForwardResponse
        TaskControlKind.list_port_forwards    => list_port_forwards    :PortForwardListResult
        TaskControlKind.kill_port_forward     => kill_port_forward     :KillPortForwardResponse
        TaskControlKind.git_query             => git_query             :GitQueryResponse
        TaskControlKind.set_caps              => set_caps              :SetCapsResponse
        TaskControlKind.set_parent            => set_parent            :SetParentResponse
        TaskControlKind.open_exec_run         => open_exec_run         :ExecRunResponse
        TaskControlKind.exec_run_list         => exec_run_list         :ExecRunListResponse
        TaskControlKind.exec_run_kill         => exec_run_kill         :ExecRunKillResponse
        TaskControlKind.board_retract         => board_retract         :BoardRetractResponse
        TaskControlKind.open_forward_tap      => open_forward_tap      :OpenForwardTapResponse

enum SetCapsStatus:
    :u8
    ok             = "ok"
    not_found      = "not_found"
    not_operator   = "not_operator"
    internal_error = "internal_error"
    # The scope is inconsistent: an override mask that is empty or overlaps
    # another, or a vis_base set without its presence bit. NOT about how much
    # authority it grants -- an operator may grant anything, including more
    # than it holds itself. Appended, so an old client renders an unfamiliar
    # status as its number rather than failing to decode.
    invalid_scope  = "invalid_scope"

# SetCapsRequest rewrites a live task's authority. Unlike a resume-time
# re-grant it has no terminal-state precondition: the point is to change a task
# that is still running.
#
# caps_present / scope_present are presence bits, not conveniences. They are
# named *_present rather than set_* because the generated getter for a u1
# named set_scope is `SetScope() bool`, which reads as a setter for the
# neighbouring scope field. caps = 0 is
# Capability.none and scope{subtree, []} is a real scope, so neither field has
# a spare value meaning "leave this one alone" — the same reason
# SubmitRequest.resume_caps_override exists.
format SetCapsRequest:
    task_id    :TaskID
    caps       :Capability
    scope      :TaskScope
    overrides_len :u8   # per-capability scope overrides; masks pairwise disjoint
    overrides     :[overrides_len]ScopeOverride
    caps_present  :u1   # 1 = write caps;  0 = keep the persisted bitmask
    scope_present :u1   # 1 = write scope; 0 = keep the persisted scope
    cascade       :u1   # 1 = also clamp every descendant to the new authority
    keep_conns    :u1   # 1 = leave the affected tasks' connections open even on
                        # a narrowing (default: close them, so in-flight attaches
                        # and transfers die with the grant)
    reserved      :u4

format SetCapsResponse:
    status       :SetCapsStatus
    affected_len :u16
    affected     :[affected_len]TaskID   # target + every descendant changed
    conns_closed :u32

enum SetParentStatus:
    :u8
    ok                   = "ok"
    not_found            = "not_found"
    # parent_not_found covers both a named parent_id that is not in the store
    # and, on the swap path, a current parent whose record is gone (a pruned
    # creator — listVisibleToCaller already treats that as a reachable state).
    parent_not_found     = "parent_not_found"
    would_cycle          = "would_cycle"
    # swap on a task that is already operator-rooted: there is nothing to
    # invert. Named rather than silently succeeding as a no-op.
    no_parent            = "no_parent"
    # swap == 1 with a non-zero parent_id. Rejected rather than ignored: a
    # typed option either takes effect or errors.
    swap_takes_no_parent = "swap_takes_no_parent"
    not_operator         = "not_operator"
    internal_error       = "internal_error"

# SetParentRequest re-points task_id's parent link (its creator_task_id).
#
# Unlike SetCapsRequest this format has no presence bits. caps = 0 is
# Capability.none and scope{subtree, []} is a real scope, so neither has a
# spare value meaning "leave this alone" — a parent link does: all-zero is
# already the encoding for "operator-rooted". And there is no "not given"
# case to distinguish, because the request IS the assignment.
format SetParentRequest:
    task_id   :TaskID
    # New parent. All-zero detaches the task to the operator root. Must be
    # all-zero when swap == 1 (else swap_takes_no_parent).
    parent_id :TaskID
    # swap: invert task_id with its CURRENT parent. The target takes the
    # parent's place — inheriting the parent's own parent, which may be the
    # root — and the former parent becomes the target's child. Both links are
    # rewritten under one TaskStore lock, so the two-cycle that the equivalent
    # two-call sequence forms transiently is never observable, and this path
    # needs no cycle check.
    swap      :u1
    reserved  :u7

format SetParentResponse:
    status     :SetParentStatus
    # The target's parent before and after the change. All-zero means
    # operator-rooted, in both fields.
    #
    # new_parent is on the wire rather than left implicit because on the swap
    # path the client does not know it: the server resolves it from the former
    # parent's own link. Echoing it on the plain path too keeps one shape.
    old_parent :TaskID
    new_parent :TaskID
    # swap only: the former parent, which is now the target's child. All-zero
    # when swap was not requested.
    swapped_id :TaskID

enum NotifyLevel:
    :u8
    info = "info"
    warn = "warn"
    error = "error"

enum NotifyOrigin:
    :u8
    worker = "worker"
    external = "external"

enum NotifyStatus:
    :u8
    accepted
    no_hook
    spawn_failed

# Worker identity as text (not the typed RunnerID): a zero-value RunnerID trips
# the IpAddrLen hard assertion and panics the encoder. The hook only needs strings.
format WorkerInfo:
    task_id_len   :u16
    task_id       :[task_id_len]u8
    runner_id_len :u16
    runner_id     :[runner_id_len]u8
    repo_len      :u16
    repo          :[repo_len]u8
    hostname_len  :u16
    hostname      :[hostname_len]u8

format NotifyRequest:
    level  :NotifyLevel
    origin :NotifyOrigin
    if origin == NotifyOrigin.worker:
        worker :WorkerInfo
    title_len :u16
    title     :[title_len]u8
    text_len  :u16
    text      :[text_len]u8

format NotifyResponse:
    status :NotifyStatus

format NotifyEvent:
    ts          :u64
    client_kind :ClientKind
    level  :NotifyLevel
    origin :NotifyOrigin
    if origin == NotifyOrigin.worker:
        worker :WorkerInfo
    title_len :u16
    title     :[title_len]u8
    text_len  :u16
    text      :[text_len]u8

# Pubsub event payloads
enum StatusEventKind:
    :u8
    task_queued
    task_assigned
    task_started
    task_ended
    runner_registered
    runner_offline
    task_pruned       # appended (keeps existing ordinals stable): the server
                      # forgot a terminal task; clients remove its row. Carries
                      # task_id + kind only — task_status/task_kind are unset
                      # because the TaskStore entry is already gone.
    conn_opened       # appended: activeConns register; role likely unspecified
                      # (handshake not yet completed). Makes failed-handshake /
                      # probe / half-open conns visible.
    conn_identified   # appended: identity established (ClientHello or RunnerHello);
                      # carries the now-known role.
    conn_closed       # appended: activeConns teardown.
    task_activity     # appended: a live interactive session's PTY output
                      # crossed the busy/idle edge (server-side byte-quiescence
                      # watcher). Carries the same task_status the store holds;
                      # the payload of interest is last_output_at/output_idle_ms.
    task_observers    # appended: an observer attached to or left a live
                      # session (viewer or cowriter). Its own kind rather than
                      # a reuse of task_activity, which means something else
                      # entirely — the agent's output, not who is watching.
                      # NEEDED because an observer attach deliberately does not
                      # touch the task state machine (Running/Detached tracks
                      # only the CONTROL attach), so without this nothing tells
                      # an event-driven client the counts moved and it shows a
                      # stale figure until some unrelated event happens to
                      # arrive. Payload of interest is viewers/cowriters.
    forward_registered  # appended: a port forward joined the registry.
    forward_closed      # appended: it left. Clients drop the row.
    forward_stats       # appended, and the exact shape task_observers exists
                        # for, one object over: a forward's COUNTERS moved.
                        # Without it a client holding a listing shows an idle
                        # 0/0 while bytes cross, and nothing corrects it until
                        # some unrelated event arrives. Coalesced server-side —
                        # one sweep publishes only the forwards that changed —
                        # because the underlying quantity moves per BYTE and an
                        # event per byte is not a design.
    exec_started        # appended: an exec joined the registry.
    exec_ended          # appended: it left. Execs have no counters, so they
                        # need no stats kind — their listing is discrete, which
                        # is why these two are enough where a forward needs three.

format TaskStatusEvent:
    kind :StatusEventKind
    task_id :TaskID
    ts :u64
    task_status :TaskStatus
    task_kind :TaskKind   # carried on every event (immutable for a task's lifetime)
                          # so a TUI receiving the very first event for a task
                          # can already render the right kind without waiting for
                          # the next List snapshot.
    exit_code :i32
    last_output_at :u64   # unix-nano of the session's most recent PTY output
                          # frame at emission; 0 = no live interactive session.
                          # Mirrors TaskInfo.last_output_at and is stamped on
                          # EVERY task event (not just task_activity) so any
                          # event keeps a client's act badge current.
    output_idle_ms :u64   # server-computed now-last_output_at at emission, in
                          # ms (clock-skew-safe for clients on other hosts).
                          # Meaningless when last_output_at == 0.
    # Observers on the live session at emission, split by what they can do —
    # same values TaskInfo carries, stamped on EVERY task event for the same
    # reason last_output_at is: any event then keeps a subscriber's row current
    # without waiting for the next List snapshot. 0/0 = no live session, or a
    # session nobody is observing; the task's status separates those.
    viewers :u16
    cowriters :u16

format RunnerStatusEvent:
    kind :StatusEventKind
    runner_id :RunnerID
    ts :u64
    runner_status :RunnerStatus

# --- ConnRole: the kind of a LIVE objproto connection. Distinct from
# ClientKind (which tags a TaskControl caller in ClientHello and never carries
# `runner`, since a runner does RunnerHello, not ClientHello). ConnRole is
# derived server-side and covers every conn kind including runner + the
# not-yet-identified state.
enum ConnRole:
    :u8
    unspecified   # handshake not yet completed (ConnOpened but not ConnIdentified)
    cli
    tui
    webui
    agent
    runner

# --- ConnInfo: one live (or just-opened/just-closed) connection. ---
format ConnInfo:
    cid_len :u8
    cid :[cid_len]u8                # ConnectionID canonical String(): "transport:ip:port-id".
                                    # The unique key used to correlate open/identified/closed
                                    # events. Already carries the remote "ip:port" (the Addr
                                    # part) plus transport and the per-connection id, so no
                                    # separate remote_addr field is needed — consumers that
                                    # want just the ip:port parse it back via ParseConnectionID.
    role :ConnRole
    principal_task :TaskID          # agent conn: its principal task id.
                                    # all-zero for cli/tui/webui/runner/unidentified.
    connected_at :u64               # unix nano, stamped at activeConns register
    identified :u1                  # 1 once role is established (handshake done);
                                    # 0 = opened-but-never-authed (probe / failed)
    reserved :u7

# --- (a) snapshot: streamed body, mirrors ListResult / ListResultBody ---
format ConnListQuery:
    reserved :u8    # no filters in v1; reserved for forward-compat
                    # (server always returns the caller's visible set)

format ConnListResult:
    stream_id :u64  # server-initiated send-stream; client reads
                    # ConnListResultBody until EOF then decodes.
                    # 0 = no stream available (treat as error).

format ConnListResultBody:
    conns_len :u16
    conns :[conns_len]ConnInfo

# --- (c) live event, mirrors TaskStatusEvent / RunnerStatusEvent ---
format ConnStatusEvent:
    kind :StatusEventKind  # conn_opened | conn_identified | conn_closed
    ts :u64
    info :ConnInfo

# ForwardStatusEvent mirrors ConnStatusEvent for forwards.status: the whole row
# travels, so a subscriber upserts on registered/stats and drops on closed —
# the same three-way apply ConnsModal already does for conns.
format ForwardStatusEvent:
    kind :StatusEventKind  # forward_registered | forward_stats | forward_closed
    ts :u64
    info :PortForwardInfo

# ExecStatusEvent is the same shape for execs.status. Two kinds, not three: an
# exec has nothing that moves while it runs.
format ExecStatusEvent:
    kind :StatusEventKind  # exec_started | exec_ended
    ts :u64
    info :ExecRunInfo

# === File transfer (client ↔ runner; see specs/2026-05-10-file-transfer-design.md) ===

enum FileTransferDirection:
    :u8
    push
    pull
    delete       # remove a file from the worktree (rejects directories).
    dir_push     # client → runner; body is a tar stream of the source dir.
    dir_pull     # runner → client; body is a tar stream of the source dir.
    dir_delete   # remove a directory from the worktree. force=0 → empty
                 # dir only (fails on non-empty); force=1 → recursive
                 # (os.RemoveAll). Rejects regular files (use `delete`).
    mkdir        # create a directory. mkdir_parents=0 → strict os.Mkdir
                 # (parent must exist, existing dir → already_exists);
                 # mkdir_parents=1 → os.MkdirAll (parents created, existing
                 # dir → ok). Mirrors Unix mkdir / mkdir -p. No body bytes;
                 # ack only, like delete. force / expected_size are ignored.

enum FileTransferStatus:
    :u8
    ok             = "ok"
    path_invalid   = "path_invalid"
    not_found      = "not_found"
    already_exists = "already_exists"
    io_error       = "io_error"
    canceled       = "canceled"
    is_directory   = "is_directory"   # delete only: rel_path resolved to a directory.
    not_a_directory = "not_a_directory"  # dir_push: dest exists but is a regular file. dir_pull / dir_delete: source is a regular file (not a directory).
    not_empty       = "not_empty"     # dir_delete: target directory is non-empty and force=0 (recursive not requested).
    range_invalid   = "range_invalid"  # offset/length were set on a direction that has no
                                       # byte range (anything but pull). Refused rather than
                                       # ignored: ignoring it would hand a caller who asked
                                       # for a slice the whole object.

format FileTransferAck:
    status      :FileTransferStatus
    actual_size :u64   # bytes carried by THIS transfer's body. A ranged pull
                       # sends only the requested slice, so this is the slice —
                       # which is already what push (bytes written) and dir_pull
                       # (bytes in) meant by it.
    total_size  :u64   # size of the complete object: the file size for a pull,
                       # ranged or not. Every other direction transfers the
                       # whole object, so writeAck sets it equal to actual_size;
                       # delete / mkdir leave both 0.

# FileTransferAck is fixed-size; expose its on-the-wire byte length so
# readers can pre-allocate and consume exactly that many bytes from the
# stream without an in-band length prefix.
FileTransferAckSize ::= sizeof(FileTransferAck)

format FileEntry:
    name_len :u16
    name     :[name_len]u8
    size     :u64
    mode     :u32
    is_dir   :u1
    reserved :u7

format FileListing:
    count   :u32
    entries :[count]FileEntry

format OpenFileTransferRequest:
    task_id       :TaskID
    direction     :FileTransferDirection
    rel_path_len  :u16
    rel_path      :[rel_path_len]u8
    expected_size :u64
    offset        :u64    # pull only: first byte to send. 0 = from the start.
                          # A non-zero value on any other direction is answered
                          # range_invalid.
    length        :u64    # pull only: max bytes to send. 0 = to EOF, so the
                          # zero value of both fields is "the whole file" and
                          # every pre-range caller keeps its meaning.
    force         :u1
    mkdir_parents :u1     # push / dir_push: create missing parent
                          # directories of the destination before writing.
                          # mkdir: MkdirAll instead of strict Mkdir.
                          # Ignored by pull / delete / dir_pull / dir_delete.
    reserved      :u6

enum OpenFileTransferStatus:
    :u8
    ok             = "ok"
    no_such_task   = "no_such_task"
    runner_offline = "runner_offline"
    internal_error = "internal_error"

format OpenFileTransferResponse:
    status    :OpenFileTransferStatus
    stream_id :u64

format ListFilesRequest:
    task_id      :TaskID
    rel_path_len :u16
    rel_path     :[rel_path_len]u8

enum ListFilesStatus:
    :u8
    ok              = "ok"
    no_such_task    = "no_such_task"
    runner_offline  = "runner_offline"
    path_invalid    = "path_invalid"
    not_found       = "not_found"
    not_a_directory = "not_a_directory"
    io_error        = "io_error"
    internal_error  = "internal_error"

format ListFilesResponse:
    status    :ListFilesStatus
    stream_id :u64

format RunnerOpenFileTransferRequest:
    task_id       :TaskID
    stream_id     :u64
    direction     :FileTransferDirection
    rel_path_len  :u16
    rel_path      :[rel_path_len]u8
    expected_size :u64
    offset        :u64    # pull only: first byte to send. 0 = from the start.
                          # A non-zero value on any other direction is answered
                          # range_invalid.
    length        :u64    # pull only: max bytes to send. 0 = to EOF, so the
                          # zero value of both fields is "the whole file" and
                          # every pre-range caller keeps its meaning.
    force         :u1
    mkdir_parents :u1     # push / dir_push: create missing parent
                          # directories of the destination before writing.
                          # mkdir: MkdirAll instead of strict Mkdir.
                          # Ignored by pull / delete / dir_pull / dir_delete.
    reserved      :u6

format RunnerListFilesRequest:
    task_id      :TaskID
    stream_id    :u64
    rel_path_len :u16
    rel_path     :[rel_path_len]u8

# === Port forwarding (client ↔ runner; see specs/2026-06-02-port-forward-design.md) ===

enum PortForwardDirection:
    :u8
    local    # client listens, runner dials remote_host:remote_port (SSH -L).
    remote   # runner listens on bind_addr:bind_port, client dials remote_host:remote_port (SSH -R).

enum ClientEndpointKind:
    :u8
    os_socket   # client-side endpoint is an OS socket: the listener for -L, the dial for -R.
    in_process  # client-side endpoint lives inside the client process, KIND UNSAID. The
                # address pair describing the client side is therefore empty: bind_addr /
                # bind_port for a local forward, target_host / target_port for a remote one.
                # Only local x in_process is defined; the server rejects remote x in_process,
                # and that refusal must test the PREDICATE below, not equality with this
                # member.
                #
                # Kept as a member rather than replaced by the specific kinds, and that is
                # what makes this addition need no coordinated restart: a client older than
                # the split sends this value, which stays legal and renders as it always did.
                # Widening the enum rather than appending a FIELD is the same choice — the
                # wire is STRICT about length (a message one byte short decodes as EOF, not
                # as a zero value) and TOLERANT of an enum value it does not know (measured
                # 2026-08-29: an unknown u8 round-trips unchanged). So a new member costs
                # old peers a fallback rendering; a new field would have cost them the
                # message.
    # The specific kinds. `(in-process)` named four different clients at once, and a row
    # the operator did not create said nothing about whether killing it was safe: the ssh
    # gateway's row — holding a remote editor's whole session open — read exactly like a
    # WebUI preview pin. Every one of these still has an empty client-side address pair and
    # is still unsavable into a workspace; the name is the only thing added.
    in_process_stdio        # `forward -W`: this process's stdin/stdout is the client end
    in_process_http         # one built HTTP request (`-W --http-path`, the WebUI's fetch)
    in_process_pane         # a raw-connect pane (the TUI's `t`, the WebUI's)
    in_process_preview      # a WebUI preview pin
    in_process_ssh_gateway  # a direct-tcpip channel the ssh gateway serves

# Capability is a bitmask of server-mediated capabilities bound to a task at
# spawn time. It is a u32 power-of-two flag set; do NOT add is_defined assertions
# to fields typed :Capability — they carry OR-combinations, not single members.
enum Capability:
    :u32
    none           = 0x000, "none"
    spawn          = 0x001, "spawn"
    cancel         = 0x002, "cancel"
    # The three attach modes are three different powers, so they are three bits,
    # ranked by blast radius. They are checked with IMPLICATION (control ⊇
    # cowrite ⊇ view) rather than as an exact match: a holder of the stronger
    # power can always choose to exercise the weaker one, and making it hold two
    # bits to do so would be bookkeeping, not confinement.
    #
    # exec_control keeps 0x004 — it was exec_attach, which gated all three modes
    # at once. Keeping the bit means every task already carrying it keeps the
    # strongest power it was granted and loses nothing; only the NAME changed,
    # and the WAL persists the number.
    exec_control   = 0x004, "exec_control"
    file_read      = 0x008, "file_read"
    file_write     = 0x010, "file_write"
    forward_local  = 0x020, "forward_local"
    forward_remote = 0x040, "forward_remote"
    notify         = 0x080, "notify"
    prune          = 0x100, "prune"
    runner_admin   = 0x200, "runner_admin"
    # board_observe keeps 0x400 -- it was info_global, which gated task
    # visibility, connection visibility AND the agentboard enumeration
    # surfaces. The first two moved to TaskScope.vis_base; this bit kept the
    # third, because the board is keyed by topic and no task scope can bound
    # it. The WAL persists the number, so no record migrates.
    #
    # "observe" rather than "read": the bit is not needed to send, to
    # subscribe, or to read your own inbox -- only to observe OTHER agents'
    # topics, messages and subscribers. An agent denied "board_read" would go
    # debugging a messaging path that is working fine.
    board_observe  = 0x400, "board_observe"
    # purge authorizes destroying an agentboard topic's retained-message ring
    # (agent purge --topic). Distinct from prune (which forgets TERMINAL TASK
    # records, self-scoped/benign): purge drops LIVE retained messages on a
    # possibly-shared topic, so it can wipe another agent's unconsumed inbound
    # channel. Different blast radius → its own bit, default-off.
    #
    # It gates board_retract too, which withdraws ONE message from every
    # agent-facing path while leaving it readable on the operator surfaces.
    # That is strictly less than this bit already permits — purge reaches the
    # same message and destroys the bytes — so it rides here rather than
    # claiming a bit of its own. The consequence, stated because it is a real
    # limit: "may withdraw but may not destroy" is not a grantable shape.
    purge          = 0x800, "purge"
    # exec_view / exec_cowrite are the two weaker attach powers, split out of
    # what exec_attach used to grant wholesale. Default-off and appended, so no
    # existing grant changes meaning.
    #
    # exec_view can only READ a session's stream. exec_cowrite can additionally
    # inject keystrokes into it — a session someone else is driving — but cannot
    # take the writer slot; exec_control can, which evicts whoever holds it.
    # The distinction is what a grant actually hands over: "let this supervisor
    # watch its workers" used to also mean "let it type into them and kick the
    # human off", because one bit gated all three.
    exec_view      = 0x1000, "exec_view"
    exec_cowrite   = 0x2000, "exec_cowrite"
    # exec_resize is ORTHOGONAL to the three attach modes, not a fourth rank in
    # them. Resizing is availability (a wrong size makes a full-screen program
    # refuse to draw at all) while typing is integrity (it runs commands as that
    # session), so "may drive this worker but must not resize it" and "may make
    # it readable but must not type into it" are both things one may want to
    # grant, and neither implies the other.
    #
    # No new message carries it: TerminalWindowSize is already its own frame
    # type and the observer input path already discriminates on it — the wire
    # carried the distinction before the capability did, which is the second
    # half of this file's own splitting rule. Default-off, so every existing
    # grant keeps today's behaviour (observer resizes dropped).
    #
    # A CONTROL attach does not need it: owning the PTY size is what control
    # means, and its frames were never filtered. And it does not LOSE it: an
    # observer's resize is honoured only while the control seat is EMPTY, so
    # this grants a stand-in for an unattended session rather than a second
    # claimant fighting the human whose terminal defines the size.
    exec_resize    = 0x4000, "exec_resize"
    # exec_run authorizes running a command in a task's WORKTREE out of band
    # (TaskControlKind.open_exec_run), and stopping one. Not a new class of
    # authority: exec_cowrite already lets a holder type any command into
    # that session's shell, and spawn already runs arbitrary commands through
    # the bash profile. What this adds is a shape — synchronous, non-invasive,
    # no task created — not a power.
    exec_run       = 0x8000, "exec_run"
    # forward_tap authorizes READING THE PAYLOAD of a port forward — the
    # cleartext of whatever protocol it carries, which routinely means an
    # Authorization header, a git credential or a database password. Holding a
    # forward is a different power from reading what crosses it, so
    # forward_local does not imply this and neither does forward_remote.
    #
    # It is not the gate on the always-on byte COUNTERS: those ride the listing
    # every caller that can see a forward already gets, and a count is not a
    # payload.
    forward_tap    = 0x10000, "forward_tap"
    # `all` is a LITERAL, not "every defined bit", so it widens by hand — the
    # same edit exec_view / exec_cowrite / exec_resize each needed. The WAL
    # persists the NUMBER, so a task already granted `all` holds 0xffff and
    # does NOT gain forward_tap until it is re-granted. That is the safe
    # direction and needs no migration.
    #
    # Widening it is REQUIRED, not stylistic: callerCaps hands operator
    # connections Capability_All, so a literal left at 0xffff would deny the
    # operator its own feature.
    all            = 0x1ffff, "all"

# ScopeBase is the base target set a TaskScope starts from, before its explicit
# id list is unioned in. Self joins that union unless exclude_self removes it,
# and it is in the VISIBILITY set unconditionally either way: seeing your own
# row is orientation, not authority.
enum ScopeBase:
    :u8
    # subtree is 0 deliberately. Three things read a zero and all three must
    # mean the default: a client that sends no scope, a WAL record written
    # before scopes existed (its JSON fields are omitempty), and a zero-valued
    # Go struct. With none = 0 each would have needed a "was it unset, or was
    # it none?" special case.
    subtree = 0, "subtree"
    none    = 1, "none"
    global  = 2, "global"

# TaskScope bounds WHICH tasks a task's capabilities may be pointed at, the
# axis Capability does not carry. The effective target set is
#
#     {self} u baseSet(base) u ids
#
# so `none` is not "nothing" — a task can always reach its own log, worktree
# and session. Clamping a child's scope at spawn ranks bases by permissiveness
# (none < subtree < global), NOT by numeric value, and an unrecognised byte
# from a newer peer ranks as none so the failure is closed.
format TaskScope:
    base             :ScopeBase
    # Visibility rank. Read only when vis_base_present is 1, and MUST be 0 when
    # it is 0 -- otherwise one authority has two encodings, which compare
    # unequal and render differently. vis_base_present = 0 pins the pair to the
    # diagonal, which is why every pre-change record is legal by construction.
    vis_base         :ScopeBase
    # 0 = {self} is in the ACTION set. Phrased negatively so the zero value is
    # the old unconditional self; include_self would have replayed every legacy
    # record into "cannot touch my own worktree".
    exclude_self     :u1
    vis_base_present :u1
    reserved         :u6
    # View-only extras: seen, never actionable. The one way to express "watch
    # this sibling, touch nothing" without granting an action id and then
    # overriding every bit to exclude it -- a form where one forgotten bit
    # reaches it.
    vis_ids_len      :u16
    vis_ids          :[vis_ids_len]TaskID
    ids_len          :u16
    ids              :[ids_len]TaskID

# One override: a capability MASK and the scope those bits resolve through.
# Masks within one list are pairwise disjoint (validated where the value is
# written), so override(cap) is a lookup and never needs a precedence rule.
#
# Not a nested TaskScope: an override has no visibility of its own, so nesting
# would carry vis_* fields that must be validated as always-zero. An override
# narrows on the base axis only -- it may name ids outside the base set,
# because a granted id was disclosed by the granter and joins the visibility
# set, and its base is bounded by NEITHER the action base nor the visibility
# rank: `scope=none +exec_view:global` is a task that enumerates nothing and
# looks at whatever id it is handed, which is what a board-driven observer
# wants. A task can therefore reach targets its own ls does not list; the scope
# column, not ls, is the statement of its reach.
format ScopeOverride:
    caps         :Capability
    base         :ScopeBase
    exclude_self :u1
    reserved     :u7
    ids_len      :u16
    ids          :[ids_len]TaskID

enum OpenPortForwardStatus:
    :u8
    ok             = "ok"
    no_such_task   = "no_such_task"
    runner_offline = "runner_offline"
    internal_error = "internal_error"
    bind_failed    = "bind_failed"
    # forward_id named no live registration — unknown, already killed, or 0.
    # Appended, so existing ordinals are unchanged.
    no_such_forward = "no_such_forward"

# RegisterPortForwardRequest: one registration, either direction. Direction
# decides what the address pair means:
#   local  : bind_* is the CLIENT's already-bound listener; target_* is what the
#            RUNNER dials per connection.
#   remote : bind_* is the listener the RUNNER is asked to open; target_* is what
#            the CLIENT dials per connection.
format RegisterPortForwardRequest:
    task_id         :TaskID
    direction       :PortForwardDirection
    bind_addr_len   :u16
    bind_addr       :[bind_addr_len]u8
    bind_port       :u16
    target_host_len :u16
    target_host     :[target_host_len]u8
    target_port     :u16
    client_endpoint :ClientEndpointKind

# Reuses OpenPortForwardStatus. A local registration can only answer ok,
# no_such_task or internal_error: its listener is bound client-side before the
# request is sent, and the runner is not consulted.
format RegisterPortForwardResponse:
    status     :OpenPortForwardStatus
    forward_id :u64
    stream_id  :u64   # server-created control stream; 0 on failure

format PortForwardListQuery:
    task_id :TaskID   # all-zero = every forward visible to the caller

format PortForwardListResult:
    stream_id :u64    # server-initiated send-stream carrying PortForwardListResultBody
                      # until EOF (mirrors ConnListResult). 0 = error.

format PortForwardInfo:
    forward_id      :u64
    direction       :PortForwardDirection
    task_id         :TaskID
    bind_addr_len   :u16
    bind_addr       :[bind_addr_len]u8
    bind_port       :u16
    target_host_len :u16
    target_host     :[target_host_len]u8
    target_port     :u16
    origin_kind     :ClientKind          # which surface holds it
    origin_cid_len  :u8
    origin_cid      :[origin_cid_len]u8  # ConnectionID canonical String(), as in ConnInfo.cid;
                                         # the only way to tell two identical specs apart
    client_endpoint :ClientEndpointKind
    # Always-on traffic accounting, appended. Before these, a registration
    # described only how it was CONFIGURED: an idle forward and a saturated one
    # rendered identically, and "is this an abandoned registration?" had no
    # answer on any surface.
    #
    # Named against this row's own target_host:target_port rather than tx/rx,
    # because the connection INITIATOR is on the client side for -L and on the
    # runner side for -R — tx/rx would silently invert between the two.
    bytes_to_target       :u64
    bytes_from_target     :u64
    conns_total           :u64  # accepted since registration; never decreases
    conns_open            :u32
    taps                  :u16  # taps reading this forward RIGHT NOW, so a
                                # forward cannot be watched invisibly
    last_activity_unix_ms :u64  # 0 = no byte has ever crossed. Rendered as
                                # "never", not as a zero duration.

format PortForwardListResultBody:
    forwards_len :u16
    forwards     :[forwards_len]PortForwardInfo

enum KillPortForwardStatus:
    :u8
    ok              = "ok"
    no_such_forward = "no_such_forward"   # unknown id OR not visible to the caller
                                          # (an invisible id must not become an
                                          # existence oracle for a confined agent)
    internal_error  = "internal_error"

format KillPortForwardRequest:
    forward_id :u64

format KillPortForwardResponse:
    status :KillPortForwardStatus

# --- control stream records (server -> client) ---
enum PortForwardEventKind:
    :u8
    conn_notify   # remote forwards only: dial your local target, pick up stream_id
    closed        # both directions: stop this forward

enum PortForwardCloseReason:
    :u8
    killed     # kill_port_forward was called
    task_gone  # the owning task left Running/Detached

format PortForwardClosed:
    reason :PortForwardCloseReason

format PortForwardEvent:
    kind :PortForwardEventKind
    match kind:
        PortForwardEventKind.conn_notify => conn_notify :RemoteForwardConnNotify
        PortForwardEventKind.closed      => closed      :PortForwardClosed
        .. => error("Unexpected port forward event")

# --- forward tap (server -> client, one stream per open_forward_tap) ---

# Direction is named against the forward's own target_host:target_port, so it
# means the same thing for -L and -R. tx/rx would invert between them: the
# connection initiator is on the client side for one and the runner side for
# the other.
enum ForwardTapDirection:
    :u8
    to_target
    from_target

enum ForwardTapFilter:
    :u8
    both
    to_target
    from_target

enum OpenForwardTapStatus:
    :u8
    ok
    no_such_forward   # unknown id OR not visible to the caller — the same
                      # deliberate conflation kill_port_forward makes, so an
                      # invisible id cannot become an existence oracle
    internal_error
    # There is no `denied` member: required_cap is checked BEFORE dispatch and
    # answers with a different response KIND (permission_denied), so this
    # handler is never entered on a capability failure and a status here would
    # have no writer.

format OpenForwardTapRequest:
    forward_id       :u64
    direction_filter :ForwardTapFilter
    # 0 = whole payload. Otherwise each record's data is cut to this many bytes
    # and truncated_bytes reports what was cut from THAT record. Cutting on the
    # SERVER is the point: doing it at the client would first spend the
    # bandwidth the option exists to save.
    max_record_bytes :u32

format OpenForwardTapResponse:
    status    :OpenForwardTapStatus
    stream_id :u64

enum ForwardTapRecordKind:
    :u8
    conn_open
    data
    gap             # the tap could not keep up; dropped_bytes were missed
    conn_close      # that connection ended, the forward is still up
    forward_closed  # the forward itself ended; the stream EOFs after this

format ForwardTapConnOpen:
    conn_seq        :u64   # per-forward, 1-based, assigned at accept
    target_host_len :u16
    target_host     :[target_host_len]u8
    target_port     :u16

format ForwardTapData:
    conn_seq      :u64
    direction     :ForwardTapDirection
    # Where this payload sits in its (conn_seq, direction) stream, counted by
    # the SERVER from that connection's first byte. Record boundaries are an
    # artifact of ReadDirect chunking and carry no application meaning, so a
    # per-record offset would restart mid-message; and a client-side counter
    # would start at 0 when the TAP opened rather than when the connection did.
    stream_offset :u64
    # Bytes cut by max_record_bytes. The NEXT record's stream_offset counts
    # them, so a cut never reads as a shorter stream.
    truncated_bytes :u32
    data_len        :u32
    data            :[data_len]u8

format ForwardTapGap:
    conn_seq      :u64
    direction     :ForwardTapDirection
    dropped_bytes :u64

format ForwardTapConnClose:
    conn_seq          :u64
    bytes_to_target   :u64   # what this ONE connection carried, each way
    bytes_from_target :u64

format ForwardTapForwardClosed:
    reason :PortForwardCloseReason

format ForwardTapRecord:
    # One of these exists per relayed chunk, on the relay goroutine that must
    # never be slowed. The default union storage boxes the arm in an interface
    # and type-asserts on every access — a heap allocation per chunk on the
    # hottest path this feature has.
    config.go.union = "noheap"
    kind    :ForwardTapRecordKind
    unix_ms :u64
    match kind:
        ForwardTapRecordKind.conn_open      => conn_open      :ForwardTapConnOpen
        ForwardTapRecordKind.data           => data           :ForwardTapData
        ForwardTapRecordKind.gap            => gap            :ForwardTapGap
        ForwardTapRecordKind.conn_close     => conn_close     :ForwardTapConnClose
        ForwardTapRecordKind.forward_closed => forward_closed :ForwardTapForwardClosed
        .. => error("Unexpected forward tap record")

# OpenPortForwardRequest: remote_host/remote_port are the runner's dial target
# for one accepted local-forward connection.
format OpenPortForwardRequest:
    task_id         :TaskID
    remote_host_len :u16
    remote_host     :[remote_host_len]u8
    remote_port     :u16
    # direction / bind_addr / bind_port removed: this message now means exactly
    # "open the data stream for one accepted local-forward connection".
    #
    # forward_id names the registration these bytes belong to. The id is minted
    # by register_port_forward, so without it the server cannot attribute a
    # splice to a row — and two forwards with an identical spec from one client
    # are indistinguishable, which is the ambiguity origin_cid above exists to
    # resolve on the listing.
    #
    # There is no "unattributed" value: 0 is refused like any other id that
    # resolves to nothing. A stream naming no registration would be a forward no
    # listing shows, no counter counts and no kill can name — the state the
    # registry exists to prevent.
    forward_id      :u64

# OpenPortForwardResponse: stream_id is the data stream for the accepted
# connection.
format OpenPortForwardResponse:
    status    :OpenPortForwardStatus
    stream_id :u64
    # forward_id removed: it was the -R registration handle, now returned by
    # RegisterPortForwardResponse.

format RunnerOpenPortForwardRequest:
    task_id           :TaskID
    stream_id         :u64
    direction         :PortForwardDirection
    remote_host_len   :u16
    remote_host       :[remote_host_len]u8
    remote_port       :u16
    bind_addr_len     :u16
    bind_addr         :[bind_addr_len]u8
    bind_port         :u16
    forward_id        :u64

# ClosePortForwardRequest tells the runner to stop a remote-forward listener.
format ClosePortForwardRequest:
    forward_id :u64

# RemoteForwardConn (runner -> server): a connection arrived on a remote-forward
# listener; stream_id is the runner-created stream for it.
format RemoteForwardConn:
    forward_id :u64
    stream_id  :u64

# RemoteForwardConnNotify (server -> client, on the control stream): dial your
# local target and pick up the data stream by stream_id.
format RemoteForwardConnNotify:
    stream_id :u64

# RemoteForwardBindResult (runner -> server): result of trying to open the
# remote-forward listener. ok=1 if bound, 0 if net.Listen failed. The server
# blocks the registration response until this arrives, so the client learns
# success/failure instead of a silent no-op.
format RemoteForwardBindResult:
    forward_id :u64
    ok         :u1
    reserved   :u7

# === Read-only git view (see specs/2026-08-03-git-view-design.md) ===

enum GitQueryKind:
    :u8
    log      # commit list for the picker pane
    diff     # unified diff between base_rev and the chosen target
    show     # one commit: header + its diff
    status   # porcelain state: uncommitted + untracked
    subrepos # list the git repo roots nested under the current root
    file     # one file's whole content, from the side `target` names:
             # worktree -> the file on disk, index -> `git show :<path>`,
             # rev -> `git show <target_rev>:<path>`. `path` must name exactly
             # one file for this kind.

# What the right-hand side of the diff is. base_rev is always the left.
enum GitDiffTarget:
    :u8
    worktree   # the working tree    -> git diff [base]
    index      # the staged tree     -> git diff --cached [base]
    rev        # target_rev names it -> git diff base target_rev

format GitQueryRequest:
    task_id        :TaskID
    kind           :GitQueryKind
    target         :GitDiffTarget   # diff only; ignored by log/show/status
    base_rev_len   :u16
    base_rev       :[base_rev_len]u8   # commit-ish. empty: diff -> the index,
                                       # show -> HEAD, log -> the task tip.
    target_rev_len :u16
    target_rev     :[target_rev_len]u8 # only when target == rev
    path_len       :u16
    path           :[path_len]u8       # worktree-relative pathspec; empty = all
    max_commits    :u32                # log only. 0 -> 100, clamped to 1000
    max_bytes      :u32                # diff/show only. 0 -> 2MiB, clamped to 8MiB
    subrepo_len    :u16
    subrepo        :[subrepo_len]u8    # worktree-relative directory that is
                                       # itself a git repo root; the WHOLE query
                                       # runs there. Empty = the task's own
                                       # worktree. This is not a pathspec: `path`
                                       # filters within a repository, `subrepo`
                                       # chooses which repository.
    submodule_diff :u1                 # diff / show: pass --submodule=diff so a
                                       # submodule's own file-level changes are
                                       # inlined. Off by default — git's own
                                       # default, and the combined output is no
                                       # longer an applyable patch.
    reserved       :u7

enum GitQueryStatus:
    :u8
    ok             = "ok"
    no_such_task   = "no_such_task"
    runner_offline = "runner_offline"
    internal_error = "internal_error"

format GitQueryResponse:
    status    :GitQueryStatus
    stream_id :u64              # 0 unless status == ok

format RunnerGitQueryRequest:
    task_id        :TaskID
    stream_id      :u64
    repo_path_len  :u16
    repo_path      :[repo_path_len]u8  # from the server's task record; the
                                       # runner re-validates it against its own
                                       # AllowedRoots before running anything.
    kind           :GitQueryKind
    target         :GitDiffTarget
    base_rev_len   :u16
    base_rev       :[base_rev_len]u8
    target_rev_len :u16
    target_rev     :[target_rev_len]u8
    path_len       :u16
    path           :[path_len]u8
    max_commits    :u32
    max_bytes      :u32
    subrepo_len    :u16
    subrepo        :[subrepo_len]u8
    submodule_diff :u1
    reserved       :u7

enum GitRunStatus:
    :u8
    ok               = "ok"
    repo_not_allowed = "repo_not_allowed"  # repo_path is not under --roots
    no_source        = "no_source"         # no worktree and no harness/<task> ref
    not_a_git_repo   = "not_a_git_repo"
    bad_rev          = "bad_rev"           # unresolvable, or '-'-leading
    git_failed       = "git_failed"        # non-zero exit for another reason
    io_error         = "io_error"
    subrepo_invalid  = "subrepo_invalid"   # subrepo escaped the worktree, passed
                                           # through a symlink, does not exist, or
                                           # exists but is not a repo root
    # Appended, not inserted: these are positional ordinals, so slotting a new
    # member next to a related one renumbers everything after it and a peer on
    # the other build reads one status as another.
    file_not_found   = "file_not_found"    # file kind: no path given, or the path
                                           # is absent from the named side

format GitCommit:
    sha_len     :u8             # 40 for sha1 repos, 64 for sha256 ones — a
    sha         :[sha_len]u8    # fixed [40]u8 would be a hard assertion the
                                # encoder panics on the day a sha256 repo appears
    author_len  :u16
    author      :[author_len]u8
    when        :u64            # author date, unix seconds
    subject_len :u16
    subject     :[subject_len]u8

format GitLogBody:
    count     :u32
    commits   :[count]GitCommit
    truncated :u1               # max_commits cut the list short
    reserved  :u7

format GitStatusEntry:
    xy       :[2]u8             # the two porcelain status bytes, e.g. " M", "??"
    path_len :u16
    path     :[path_len]u8

format GitStatusBody:
    count   :u32
    entries :[count]GitStatusEntry

format GitSubrepoEntry:
    path_len :u16
    path     :[path_len]u8      # relative to the query's current root

format GitSubrepoBody:
    count     :u32
    entries   :[count]GitSubrepoEntry
    truncated :u1               # the candidate cap cut the walk short; a cap
    reserved  :u7               # that is not reported reads as "there were none"

format GitTextBody:
    len       :u64
    text      :[len]u8          # git's stdout verbatim (--no-color)
    truncated :u1               # max_bytes cut the text short
    reserved  :u7

# GitQueryResult is what the runner writes to the stream named by
# GitQueryResponse.stream_id. When status != ok the body arm is still
# present and empty (count = 0 / len = 0): a few wasted bytes on the
# error path beats conditional encoding that is harder to round-trip test.
#
# The status arm is named status_body, not status, because this format
# already has a `status` field and the two would collide in the generated
# accessors.
format GitQueryResult:
    status     :GitRunStatus
    stderr_len :u16
    stderr     :[stderr_len]u8  # git's stderr, trimmed; empty when ok
    kind       :GitQueryKind
    match kind:
        GitQueryKind.log    => log         :GitLogBody
        GitQueryKind.status => status_body :GitStatusBody
        GitQueryKind.diff     => diff        :GitTextBody
        GitQueryKind.show     => show        :GitTextBody
        GitQueryKind.subrepos => subrepos    :GitSubrepoBody
        GitQueryKind.file     => file        :GitTextBody

# ---------------------------------------------------------------------------
# Out-of-band exec: run one argv in a task's worktree as its own process.
#
# Design: docs/superpowers/specs/2026-08-25-task-exec-design.md
#
# The DATA plane is not described here — it is the objtrsf exec frame protocol
# (Stdout / Stderr / Stdin), reached through the stream ExecRunResponse names.
# What is here is the control plane: starting one, listing them, stopping one,
# and carrying the exit code, which the frame protocol has no shape for and
# deliberately does not grow one (that protocol is pre-trsf legacy; sideband
# goes in a separate trsf stream).
# ---------------------------------------------------------------------------

# ExecArg is one argv element. u16 per element matches ClaudeArg, for the same
# reason: individual arguments are short in practice and 64 KiB is past any
# real one.
format ExecArg:
    arg_len :u16
    arg :[arg_len]u8

format ExecArgv:
    argv_len :u16
    argv :[argv_len]ExecArg

format ExecRunRequest:
    task_id :TaskID
    argv :ExecArgv
    # stdin_enabled=0 gives the child /dev/null as its stdin, which is what a
    # non-interactive caller wants: a child that reads stdin then gets EOF
    # rather than hanging forever on a pipe nobody will write to.
    #
    # /dev/null rather than a pipe closed a moment later, and the difference is
    # not pedantry: closing leaves a window (measured at 6ms) in which stdin is
    # open and empty, so a child that distinguishes "no input yet" from "end of
    # input" gets a racing answer. The runner reads this flag —
    # objtrsf ExecuteOption.StdinDevNull — and for one release it did not,
    # which is what made `exec <task> -- bash` from the TUI hang forever.
    stdin_enabled :u1
    # shell_line=1 means argv holds exactly ONE element: a command LINE for the
    # runner's own shell to interpret, rather than an argv to exec directly.
    # The runner picks `sh -c <line>` or `cmd /c <line>` from its own platform.
    #
    # It exists because D4 — "a caller that wants a shell sends ['sh','-c',line]
    # itself" — assumes the caller knows what shell exists on the far side. That
    # holds for a human typing `harness-cli exec`; it does NOT hold for the ssh
    # gateway, which is handed one opaque string by `ssh host cmd` and has no
    # human to ask. It hard-coded `sh -c`, which fails on a stock Windows runner
    # and only worked on one because Git for Windows had put sh on PATH.
    #
    # The choice belongs to the party that KNOWS, which is the runner.
    #
    # Declared AFTER stdin_enabled, and that is not cosmetic: both live in the
    # same byte, so putting a new flag FIRST shifts every bit behind it and a
    # peer on the old build reads shell_line as stdin_enabled. Not a decode
    # failure — a silent misreading, which is worse. Caught by running the ssh
    # path against a not-yet-restarted server, where the gateway's shell_line=1
    # arrived as stdin_enabled=1 and the command line was exec'd as a program
    # name. New bits go at the END of the reserved run.
    shell_line :u1
    # sshd_parent=1 asks the runner to run the shell line under a process whose
    # NAME is sshd, rather than under its ordinary shell.
    #
    # For a client that decides whether it is talking to a real SSH server by
    # walking its own parent-process chain and comparing process NAMES. VS Code
    # Remote-SSH is one: its Windows bootstrap's first statement walks
    # win32_process.parentprocessid looking for an ancestor named `sshd`, and
    # through the harness there is none, so it prints "no sshd parent proc" and
    # exits 0 — a SILENT success that leaves the operator with no error to read.
    # Measured on a Windows runner 2026-08-25: the chain through an exec is
    # powershell -> cmd.exe -> agent-runner.exe.
    #
    # Only the name is checked, so the runner satisfies it with a COPY of the
    # platform shell under that name — no ssh implementation is involved and
    # nothing listens on a port. That is also the honest limit of this flag: it
    # makes a name check pass, and claims nothing else about the process.
    #
    # Wired on Windows ONLY, and that is a measured scope boundary rather than
    # anything inherent. The name walk exists on Windows because that bootstrap
    # has to FIND a pid to pass to `--parent-process-id`; the POSIX bootstrap
    # passes `$$` and inspects no process name at all (read from
    # linux-exec-server-installer.sh across 0.124.0 / 0.126.0 / 0.128.0 —
    # `grep -c sshd` is 0 in every one). So there is no POSIX client asking for
    # this, not a POSIX impossibility. A runner elsewhere REFUSES the exec
    # rather than running it without the property: the caller asked for
    # something the command would not have, and reporting success for that is
    # worse than a refusal.
    sshd_parent :u1
    reserved :u5

enum ExecRunStatus:
    :u8
    ok
    # not_found covers "no such task" AND "outside your scope", deliberately
    # indistinguishable — the same choice CancelResult.no_such_task makes,
    # because reporting the difference confirms that a task you may not see
    # exists.
    not_found
    # no_worktree: nothing to run IN. The task ended clean and its worktree was
    # removed, or it never had one. A task that ended DIRTY keeps its worktree
    # and is a valid target.
    no_worktree
    runner_unreachable
    empty_argv
    denied
    internal_error

format ExecRunResponse:
    status :ExecRunStatus
    exec_id :u64
    data_stream_id :u64
    control_stream_id :u64

enum ExecEventKind:
    :u8
    exited               # the child ran and ended; exit_code is its own
    killed               # exec_run_kill, or the runner was torn down
    failed               # the child never started (no such binary, cwd gone)

# ExecEvent is the ONE record the server writes to the control stream before
# closing it. Its arrival is how a client learns the command ended.
format ExecEvent:
    kind :ExecEventKind
    # The child's own exit code for `exited`, -1 for the other two — the
    # convention TaskFinished uses, for the same reason: a death by signal has
    # no exit code to report, and inventing 127 or 137 would be a shell's
    # convention applied where there is no shell.
    exit_code :i32
    detail :[..]u8       # human-readable; empty for a clean `exited`

format RunnerExecRunRequest:
    exec_id :u64
    task_id :TaskID
    auth_ticket :[16]u8
    stream_id :u64       # bidi stream toward the runner for the frame protocol
    # repo_path travels from the SERVER's task record, as RunnerGitQueryRequest's
    # does and for the same reason: the runner drops its per-task entry when a
    # task ends, so it cannot resolve the worktree of a TERMINAL task on its
    # own. The runner re-validates this against its --roots before running.
    repo_path_len :u16
    repo_path :[repo_path_len]u8
    argv :ExecArgv
    stdin_enabled :u1
    # Relayed verbatim; see ExecRunRequest.shell_line.
    shell_line :u1
    # Relayed verbatim; see ExecRunRequest.sshd_parent.
    sshd_parent :u1
    reserved :u5

format ExecRunFinished:
    exec_id :u64
    exit_code :i32
    kind :ExecEventKind
    detail :[..]u8

# ExecRunInfo is one row of `exec ls`. origin_kind/origin_cid say WHOSE it is —
# the registry is shared, so two identical argvs from different clients are
# otherwise indistinguishable, which is the same reason PortForwardInfo carries
# its origin.
format ExecRunInfo:
    exec_id :u64
    task_id :TaskID
    started_unix_ms :u64
    argv :ExecArgv
    origin_kind :ClientKind
    origin_cid_len :u8
    origin_cid :[origin_cid_len]u8

format ExecRunListRequest:
    task_filter :TaskID  # all-zero = every exec the caller may see

# ExecRunListResponse names a stream rather than carrying the rows inline, the
# way PortForwardListResult and ListResult do and for their reason: a listing
# whose rows carry whole argvs has no bound that fits a UDP path MTU.
format ExecRunListResponse:
    stream_id :u64    # server-initiated send-stream carrying ExecRunListBody
                      # until EOF. 0 = the server could not allocate one.

format ExecRunListBody:
    execs_len :u16
    execs :[execs_len]ExecRunInfo

# CloseExecRunRequest asks the runner to cancel a running exec, which stops
# the child through the SIGHUP -> SIGTERM -> SIGKILL ladder a detaching
# session's agent gets. Mirrors ClosePortForwardRequest.
format CloseExecRunRequest:
    exec_id :u64

format ExecRunKillRequest:
    exec_id :u64

format ExecRunKillResponse:
    status :ExecRunStatus
