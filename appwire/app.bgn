
config.go.package = "appwire"


# Harness application payload kinds. They ride the same leading wire byte as the
# shared transport wire.ApplicationPayloadKind, but live in the reserved app
# range (>= 0x40) so they never collide with transport kinds (0x00-0x3F). The
# shared trsf core handles transport kinds and routes everything else (these) to
# the application control layer.
enum AppKind:
    :u8
    pubsub = 0x40
    task_control = 0x41
    relay_control = 0x42
    runner_control = 0x43
    agent_message = 0x44
    psk_auth = 0x45
    agent_proxy_control = 0x46
    dial_greeting = 0x47
    # The ONLY kind sent with trsf's SendDatagram rather than
    # Connection().SendMessage, so unlike every other it is acknowledged and
    # (in the controlled mode) congestion controlled. trsf has no datagram kind
    # of its own: THIS byte is the packet's kind, and the core routes it
    # because SetDatagramKinds claims it. A kind added here and not added there
    # is refused at the sender rather than lost at the far end.
    #
    # Telemetry deliberately does NOT travel this way. It would share a queue
    # with the traffic it measures.
    #
    # Payload: protocol.ForwardDatagram.
    forward_datagram = 0x48

    # Telemetry: the SERVER asks a peer -- a runner or a client -- for numbers
    # about itself, and the peer answers on the same kind. One family for the
    # direction, with the question inside, the way TaskControl works for the
    # other one.
    #
    # One kind rather than one per peer, because the peer kind decides only
    # which CONNECTION the request goes out on, never which question is being
    # asked. Splitting it would declare every question twice and make the
    # server's ask-and-await machinery two copies of itself, which is what it
    # briefly was.
    #
    # Pull, not push, and that is the whole shape: a number that must be
    # current when read is asked for when read. The one push that existed here
    # rode the datagram frame and therefore competed with the traffic it was
    # reporting on -- least likely to arrive exactly when it had most to say.
    #
    # Payloads: protocol.TelemetryRequest / TelemetryResponse.
    telemetry = 0x49
