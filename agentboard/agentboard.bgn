config.go.package = "agentboard"

format RunnerID:
    transport_len :u8
    transport :[transport_len]u8
    ip_addr_len :u8
    ip_addr_len == 4 || ip_addr_len == 16
    ip_addr :[ip_addr_len]u8
    port :u16
    unique_number :u16

format TaskID:
    id :[16]u8

enum AgentMessageKind:
    :u8
    send
    send_response
    subscribe
    subscribe_response
    unsubscribe
    wait
    wait_response
    inbox
    inbox_response
    deliver
    list_topics
    list_topics_response
    list_subscriptions
    list_subscriptions_response
    purge
    purge_response
    list_retained
    list_retained_response
    read_seq
    read_seq_response
    retract
    retract_response
    # inbox_advance / inbox_advance_response are appended at the END rather
    # than placed next to inbox / inbox_response: this enum is a positional
    # :u8, so an insertion mid-list renumbers every later value, and a server
    # and runner at different versions would then decode purge as
    # list_retained — silently, instead of failing.
    inbox_advance
    inbox_advance_response

enum HelloStatus:
    :u8
    ok
    bad_ticket
    unknown_task
    runner_mismatch

format SendRequest:
    request_id :u32
    # in_reply_to is the seq of the message this one answers; 0 = not a reply.
    # The server resolves it against the retained rings at publish time and
    # rejects the send when it cannot (SendStatus.unknown_in_reply_to), so a
    # non-zero value on a delivered message always denotes a real message.
    in_reply_to :u64
    topic_len :u16
    topic :[topic_len]u8
    # An empty topic is meaningful only on a reply: the server then derives the
    # destination from the parent's authenticated sender (its chat.<short-id>).
    topic_len != 0 || in_reply_to != 0
    # payload_stream_id references a client-initiated trsf send-stream
    # carrying the message payload; the server reads from the matching
    # receive stream until EOF and decodes the bytes as the publish body.
    # Streamed instead of inline so multi-KB payloads don't blow path MTU
    # on UDP. See docs/superpowers/specs/2026-05-09-udp-dualstack-design.md
    # §12.1.
    payload_stream_id :u64
    # no_retire_on_reply suppresses the reply-retire rule for THIS message:
    # normally, when the task a point-to-point message was addressed to
    # replies to it, the server retracts the original on the author's behalf
    # (see RetractRequest). A reply is proof the instruction was handled, and
    # retracting it there is what stops a recipient whose context is reset
    # from re-reading and re-doing it — without the author having to remember
    # to withdraw it.
    #
    # The bit is NEGATIVE so that its zero value is the default behaviour, the
    # same reason ScopeBase.subtree is 0: a caller that sets no bits, and a
    # struct nobody filled in, must both mean "retire on reply". Set it for a
    # message that has to survive being answered — a standing instruction, or
    # anything whose reply is an acknowledgement rather than a completion.
    #
    # The rule fires only when the parent sits on the REPLIER's own
    # chat.<short-id>, i.e. it was addressed to them specifically. A publish to
    # a shared topic is never auto-retired however this bit is set, because one
    # subscriber's reply says nothing about whether the others have read it.
    no_retire_on_reply :u1
    reserved :u7

enum SendStatus:
    :u8
    ok
    payload_too_large
    too_many_topics
    bad_frame
    unknown_in_reply_to

format SendResponse:
    request_id :u32
    status :SendStatus
    seq :u64
    # delivered_to is how many subscribers the publish matched at send time.
    # Without it `ok` covers both "everyone got it" and "nobody is listening",
    # and the sender cannot tell them apart: the retained ring accepts the
    # message either way, and the one command that would answer the question
    # (board subscribers) needs info_global, which a confined task lacks. A
    # typo'd or stale chat.<short-id> is the common way to land on zero.
    #
    # It counts the PUBLISHER too when the publisher subscribes to the target
    # topic — sending to your own chat.<short-id> is a deliberate self-ping and
    # reports 1. Clamped to u16.
    #
    # This is a weak enumeration signal (publish to a name, learn whether
    # anyone holds it), accepted on the same ground list_retained is ungated:
    # subscribe takes no capability, so whoever knows a topic name can already
    # subscribe and read its payloads via inbox. It reveals nothing to someone
    # who cannot name the topic, so it is not a discovery sweep.
    delivered_to :u16

format SubscribeRequest:
    request_id :u32
    pattern_len :u16
    pattern :[pattern_len]u8

format UnsubscribeRequest:
    request_id :u32
    pattern_len :u16
    pattern :[pattern_len]u8

enum SubscribeStatus:
    :u8
    ok
    bad_pattern

format SubscribeResponse:
    request_id :u32
    status :SubscribeStatus

format DeliveredMessage:
    seq :u64
    # in_reply_to is the seq of the message this one answers, 0 when it is not
    # a reply. Server-validated at publish time — see SendRequest.in_reply_to.
    in_reply_to :u64
    topic_len :u16
    topic :[topic_len]u8
    # payload_stream_id references a server-initiated trsf send-stream
    # carrying the delivered payload; agent reads from the matching
    # receive stream until EOF. See SendRequest.payload_stream_id for the
    # rationale (UDP MTU; streamed instead of inline).
    payload_stream_id :u64
    from_runner_id :RunnerID
    from_task_id :TaskID
    from_hostname_len :u8
    from_hostname :[from_hostname_len]u8
    # from_agent_profile is the agent profile name the sending task was running
    # under AT PUBLISH TIME (e.g. "claude" / "codex"), resolved server-side from
    # the task record — the agent does not supply it. Frozen per message because
    # a task's profile is per-open: `session new --resume` reuses a task id (and
    # so its chat.<short-id> topic) under a different runtime, so resolving it at
    # read time would misattribute everything already in the ring. Empty means
    # the server could not attribute a runtime (e.g. a server-originated
    # publish, which carries from_hostname "server"); it never means "runner
    # default".
    from_agent_profile_len :u8
    from_agent_profile :[from_agent_profile_len]u8

format WaitRequest:
    request_id :u32
    pattern_len :u16
    pattern :[pattern_len]u8
    since :u64
    timeout_ms :u32
    # in_reply_to, when non-zero, filters the wait: only a message whose
    # in_reply_to equals this satisfies it, and a non-matching publish on the
    # topic does not end the wait. Zero means no filter.
    #
    # This is what tells a reply apart from unrelated traffic. `dispatch` sets
    # it to the seq its own publish returned, so a message already retained on
    # the topic — or an answer to somebody else's question — cannot be mistaken
    # for the answer to this one.
    in_reply_to :u64

format WaitResponse:
    request_id :u32
    timed_out :u8
    next_cursor :u64
    msgs_len :u16
    msgs :[msgs_len]DeliveredMessage

format InboxRequest:
    request_id :u32
    since :u64

format InboxResponse:
    request_id :u32
    next_cursor :u64
    msgs_len :u16
    msgs :[msgs_len]DeliveredMessage

# InboxAdvanceRequest asks for the messages on this task's subscribed topics
# that the automatic injection path has not yet been given, and records them as
# given. It carries NO cursor, in either direction: the position is the
# server's (taskState.shown, per topic), so a caller has none to assert and
# none to write back.
#
# It exists as a separate kind from InboxRequest rather than a flag on it
# because only one caller may ever send it — the UserPromptSubmit hook the
# runner injects. As a flag, "do not pass this by hand" was an instruction in
# the skill file; as a kind selected by --user-prompt-submit-hook, whose output
# is a hook envelope, it is the shape of the CLI.
#
# A plain InboxRequest reads the same topics idempotently and moves nothing.
format InboxAdvanceRequest:
    request_id :u32

format InboxAdvanceResponse:
    request_id :u32
    msgs_len :u16
    msgs :[msgs_len]DeliveredMessage

format ListTopicsRequest:
    request_id :u32

format TopicSummary:
    name_len :u16
    name :[name_len]u8
    last_seq :u64
    last_published_at_unix_ms :u64
    msg_count :u16

enum ListTopicsStatus:
    :u8
    ok
    # denied is its own answer rather than an empty list. The gate is a
    # visibility scope (info_global), and an empty list is ALSO what a board
    # with no topics returns — so collapsing the two made a confined agent
    # debugging "my messages aren't arriving" read the denial as "nobody is
    # subscribed", with rc=0. Every sibling response that can be refused
    # (SendStatus / PurgeStatus / RetractStatus) already carries its refusal
    # in the schema; this one expressed it as an absence.
    #
    # Unlike RetractStatus / ReadSeqStatus below, there is no enumeration
    # oracle to guard against here: denied reports a property of the CALLER
    # (it lacks info_global — whoami already tells it that) and nothing about
    # which topics exist.
    denied

format ListTopicsResponse:
    request_id :u32
    status :ListTopicsStatus
    topics_len :u16
    topics :[topics_len]TopicSummary

format ListSubscriptionsRequest:
    request_id :u32

format SubscriptionSummary:
    pattern_len :u16
    pattern :[pattern_len]u8

format ListSubscriptionsResponse:
    request_id :u32
    subscriptions_len :u16
    subscriptions :[subscriptions_len]SubscriptionSummary

# PurgeRequest drops retained messages from a topic's ring on the server (exact
# topic match, no wildcards — same as subscribe in v1). Used to flush a
# poisoned/unwanted payload out of the server-side buffer so a since=0 re-read
# can't resurface it. Gated by Capability.purge.
#   seq == 0 → purge the WHOLE topic (delete the ring entirely).
#   seq  > 0 → drop only the single retained message with that seq, leaving the
#             rest intact (board seq starts at 1, so 0 is never a real message).
format PurgeRequest:
    request_id :u32
    topic_len :u16
    topic :[topic_len]u8
    seq :u64

enum PurgeStatus:
    :u8
    ok
    not_found
    denied

format PurgeResponse:
    request_id :u32
    status :PurgeStatus
    # purged is the number of retained messages dropped from the ring (0 when
    # not_found or denied).
    purged :u16

# ListRetainedRequest enumerates a topic's retained ring as METADATA ONLY — no
# payload bytes cross the wire. This is the content-blind way to identify which
# retained message to purge (by seq / sender / size / time) without ingesting a
# payload that might itself trip a moderation gate. No cap gate (helloed only),
# like inbox/wait: it is a keyed read of an already-named topic (not a discovery
# sweep — that is list_topics), and everything it surfaces is a strict subset of
# what subscribing + inbox already returns uncapped. Destruction (purge) needs
# Capability.purge; this read does not. Single named topic, not a board sweep.
format ListRetainedRequest:
    request_id :u32
    topic_len :u16
    topic :[topic_len]u8

# RetainedMeta is one retained-ring entry without its payload: just enough to
# decide what to purge. size is the payload length in bytes.
format RetainedMeta:
    seq :u64
    # in_reply_to is the seq of the message this one answers, 0 when it is not
    # a reply. Server-validated at publish time — see SendRequest.in_reply_to.
    in_reply_to :u64
    from_runner :RunnerID
    from_task :TaskID
    from_hostname_len :u8
    from_hostname :[from_hostname_len]u8
    # See DeliveredMessage.from_agent_profile.
    from_agent_profile_len :u8
    from_agent_profile :[from_agent_profile_len]u8
    size :u32
    received_at_unix_ms :u64

format ListRetainedResponse:
    request_id :u32
    status :PurgeStatus
    metas_len :u16
    metas :[metas_len]RetainedMeta

# ReadSeqRequest fetches ONE retained message by seq. It exists because the
# inbox hooks stop inlining a large body and hand back a pointer instead;
# without it that pointer has to say `inbox --since <seq-1>`, which re-reads
# every later message too — and inbox fetches every payload in the batch
# before emitting any, so the bytes are transferred and then discarded.
format ReadSeqRequest:
    request_id :u32
    seq :u64

enum ReadSeqStatus:
    :u8
    ok
    # not_found deliberately merges "no longer on the board" with "on a topic
    # this task does not subscribe to". Separating them would answer "does seq
    # N exist?" for every seq, which is an enumeration oracle over every ring:
    # subscribing needs a topic NAME, and that requirement is what keeps the
    # rings from being browsable. A status that leaks existence walks around it.
    not_found

format ReadSeqResponse:
    request_id :u32
    status :ReadSeqStatus
    # 1 on ok, 0 otherwise. A count rather than a bare DeliveredMessage
    # because the layout is fixed: an absent message would still have to
    # encode one, with a payload_stream_id pointing at nothing. Mirrors
    # WaitResponse / InboxResponse so the body rides the same stream path.
    msgs_len :u16
    msgs :[msgs_len]DeliveredMessage

# RetractRequest withdraws ONE message the CALLER published, named by its
# board-global seq. Withdrawal is a LOGICAL delete: the message leaves every
# agent-facing path (deliver / inbox / wait / read_seq / list_retained) but
# stays readable on the operator surfaces (harness-cli board read, TUI, WebUI)
# until it ages out like anything else. That asymmetry is the point — an agent
# can withdraw a stale instruction in seconds without shrinking the window a
# human has to audit what was said.
#
# The problem it solves: a task whose context was reset re-reads a topic's
# retained ring and re-executes instructions it already carried out. The
# knowledge that an instruction is spent lives with its SENDER, not with the
# reset recipient, so the withdrawal has to be the sender's to make.
#
# No capability gate. The gate is AUTHORSHIP — the server compares the stored
# message's from_task against the caller's authenticated task id and refuses
# otherwise, so a retract can never destroy something the caller did not write.
# Capability.purge stays the gate for PurgeRequest, which erases the bytes for
# real; that remains the escape hatch for a payload which must not survive at
# all (a leaked credential), and it reaches retracted messages too.
format RetractRequest:
    request_id :u32
    seq :u64

enum RetractStatus:
    :u8
    ok
    # not_found deliberately merges "no live message carries that seq" (never
    # published, rotated out of its ring, already retracted, purged) with
    # "published by somebody else", exactly as ReadSeqStatus.not_found merges
    # its two cases. seq is board-global and consecutive, so a separate
    # "not yours" answer would confirm the existence of any seq on any ring —
    # an enumeration oracle over topics the caller can neither name nor read.
    not_found

format RetractResponse:
    request_id :u32
    status :RetractStatus

format AgentMessage:
    kind :AgentMessageKind
    match kind:
        AgentMessageKind.send => send :SendRequest
        AgentMessageKind.send_response => send_response :SendResponse
        AgentMessageKind.subscribe => subscribe :SubscribeRequest
        AgentMessageKind.subscribe_response => subscribe_response :SubscribeResponse
        AgentMessageKind.unsubscribe => unsubscribe :UnsubscribeRequest
        AgentMessageKind.wait => wait :WaitRequest
        AgentMessageKind.wait_response => wait_response :WaitResponse
        AgentMessageKind.inbox => inbox :InboxRequest
        AgentMessageKind.inbox_response => inbox_response :InboxResponse
        AgentMessageKind.deliver => deliver :DeliveredMessage
        AgentMessageKind.list_topics => list_topics :ListTopicsRequest
        AgentMessageKind.list_topics_response => list_topics_response :ListTopicsResponse
        AgentMessageKind.list_subscriptions => list_subscriptions :ListSubscriptionsRequest
        AgentMessageKind.list_subscriptions_response => list_subscriptions_response :ListSubscriptionsResponse
        AgentMessageKind.purge => purge :PurgeRequest
        AgentMessageKind.purge_response => purge_response :PurgeResponse
        AgentMessageKind.list_retained => list_retained :ListRetainedRequest
        AgentMessageKind.list_retained_response => list_retained_response :ListRetainedResponse
        AgentMessageKind.read_seq => read_seq :ReadSeqRequest
        AgentMessageKind.read_seq_response => read_seq_response :ReadSeqResponse
        AgentMessageKind.retract => retract :RetractRequest
        AgentMessageKind.retract_response => retract_response :RetractResponse
        AgentMessageKind.inbox_advance => inbox_advance :InboxAdvanceRequest
        AgentMessageKind.inbox_advance_response => inbox_advance_response :InboxAdvanceResponse
        .. => error("Unexpected agent message kind")
