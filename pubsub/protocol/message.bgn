config.go.package = "protocol"
enum MessageKind:
    :u8
    JOIN
    LEAVE

format PubSubRequest:
    config.go.union = "noheap"
    kind :MessageKind
    request_id :u32
    if kind == MessageKind.JOIN:
        nick_name_len :u8
        nick_name :[nick_name_len]u8
    topic :[..]u8

enum Status:
    :u8 
    ok 
    already_subscribed
    unknown_message
    unknown_topic
    # forbidden answers a JOIN this connection may not make. One value for every
    # reason — no capability, a task outside the caller's scope, a task that does
    # not exist — so the answer says nothing about which tasks exist.
    forbidden

format PubSubResponse:
    request_id :u32
    status :Status 
    stream_id :u64


# PubSubFrame is the unit of a broker → subscriber pubsub stream: every byte the
# broker writes to a subscriber's stream is a sequence of these. The other
# direction — a subscriber publishing — is raw bytes, and each read the broker
# makes of it becomes one message.
format PubSubFrame:
    data_len :u32
    data :[data_len]u8

# PubSubFrameHeader is PubSubFrame's length alone: the writer sends it beside
# the payload so a large payload is not copied, and the reader decodes it to
# check the length against its cap before the payload has arrived.
format PubSubFrameHeader:
    data_len :u32
